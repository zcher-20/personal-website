---

<Layout
  seo={{
    title: "Projects | " + identity.name,
    description: "Design, UI/UX, Research, and Engineering projects by Zayneb Cherif.",
    image: identity.logo,
  }}
>
  <script id="items-data" type="application/json" set:html={JSON.stringify(ITEMS)} />

  <div class="proj-shell">

    <!-- Static header -->
    <div class="proj-header">
      <span class="wordmark-title">Projects</span>
      <span class="wordmark-sub">Computer Science · Design</span>
      <div class="wordmark-socials">
        <a href="https://www.linkedin.com/in/zayneb-cherif-830294251/" target="_blank" rel="noopener noreferrer" class="wordmark-social-link">LinkedIn ↗</a>
        <span class="wordmark-social-sep">·</span>
        <a href="https://github.com/zcher-20" target="_blank" rel="noopener noreferrer" class="wordmark-social-link">GitHub ↗</a>
        <span class="wordmark-social-sep">·</span>
        <a href="mailto:zaynebcheriff@gmail.com" class="wordmark-social-link">Gmail ↗</a>
      </div>
    </div>

  <div class="canvas" id="proj-canvas">

    <!-- Axes -->
    <div class="axis axis-h"></div>
    <div class="axis axis-v"></div>

    <!-- Axis labels -->
    <span class="al al-top">Technical</span>
    <span class="al al-bottom">Creative</span>
    <span class="al al-left">Design</span>
    <span class="al al-right">Research</span>

    <!-- Project items (hidden:true entries are excluded) -->
    {ITEMS.filter((item) => !(item as any).hidden).map((item) => (
      <div
        class="item"
        data-id={item.id}
        style={`left:${item.left};top:${item.top};width:${item.width}`}
      >
        <div class="item-img-wrap">
          <img
            src={item.image}
            alt={item.title}
            class="item-img"
            loading="lazy"
            draggable="false"
          />
          <div class="resize-handle"></div>
        </div>
        <p class="item-label">{item.shortTitle}</p>
      </div>
    ))}

  </div><!-- end canvas -->

  <!-- Mobile card list (hidden on desktop) -->
  <div class="mobile-proj-list">
    {ITEMS.filter((item) => !(item as any).hidden).map((item) => (
      <div class="mobile-proj-item" data-id={item.id}>
        <img src={item.image} alt={item.title} class="mobile-proj-img" loading="lazy" />
        <div class="mobile-proj-info">
          <p class="mobile-proj-title">{item.shortTitle}</p>
          {item.venue && <p class="mobile-proj-venue">{item.venue}</p>}
          <p class="mobile-proj-desc">{item.description}</p>
          <div class="mobile-proj-tags">
            {item.tags.map((t: string) => <span class="pm-tag">{t}</span>)}
          </div>
          <div class="mobile-proj-links">
            {item.links && item.links.length > 0
              ? item.links.map((lnk: { label: string; href: string }) => (
                  <a href={lnk.href} target="_blank" rel="noopener noreferrer" class="pm-link">{lnk.label}</a>
                ))
              : <span class="pm-link pm-link-muted">Confidential</span>
            }
          </div>
        </div>
      </div>
    ))}
  </div>

    <!-- Detail modal -->
    <div id="proj-modal" class="modal" role="dialog" aria-modal="true">
      <div class="modal-card" id="proj-modal-card">
        <button id="proj-modal-close" class="modal-close" aria-label="Close">&#x2715;</button>
        <div class="modal-left">
          <h2 id="pm-title" class="pm-title"></h2>
          <p id="pm-venue" class="pm-venue"></p>
          <p id="pm-desc" class="pm-desc"></p>
          <div id="pm-meta" class="pm-meta"></div>
          <div id="pm-tags" class="pm-tags"></div>
          <div id="pm-links" class="pm-links"></div>
        </div>
        <div class="modal-right">
          <img id="pm-image" class="pm-image" src="" alt="" />
        </div>
      </div>
    </div>

  <div class="proj-footer"></div>
  </div><!-- end proj-shell -->
</Layout>

<script is:inline>
(function () {
  var STORAGE_KEY = "proj-positions-v4";

  function getPos()     { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); } catch { return {}; } }
  function savePos(pos) { localStorage.setItem(STORAGE_KEY, JSON.stringify(pos)); }

  var rawData = document.getElementById("items-data");
  if (!rawData) return;
  var ITEMS = JSON.parse(rawData.textContent);
  var itemMap = {};
  ITEMS.forEach(function (d) { itemMap[d.id] = d; });

  var canvas = document.getElementById("proj-canvas");
  if (!canvas) return;

  // ── Convert initial % → px, restore saved state ─────────────────────────
  function initPositions() {
    var pos = getPos();
    document.querySelectorAll(".item").forEach(function (el) {
      var id = el.dataset.id;
      var saved = pos[id];
      if (saved) {
        if (saved.left)  el.style.left  = saved.left;
        if (saved.top)   el.style.top   = saved.top;
        if (saved.width) el.style.width = saved.width;
      } else {
        var cr = canvas.getBoundingClientRect();
        var er = el.getBoundingClientRect();
        el.style.left = (er.left - cr.left) + "px";
        el.style.top  = (er.top  - cr.top)  + "px";
      }
    });
  }
  requestAnimationFrame(function () {
    requestAnimationFrame(initPositions);
  });

  // ── Drag ─────────────────────────────────────────────────────────────────
  var dragging = null, dragOX = 0, dragOY = 0, smx = 0, smy = 0, didDrag = false;
  var THRESHOLD = 5;

  document.querySelectorAll(".item").forEach(function (el) {
    el.addEventListener("mousedown", function (e) {
      if (e.button !== 0 || e.target.classList.contains("resize-handle")) return;
      e.preventDefault();
      dragging = el; didDrag = false; smx = e.clientX; smy = e.clientY;
      var r = el.getBoundingClientRect();
      dragOX = e.clientX - r.left; dragOY = e.clientY - r.top;
      el.style.zIndex = "100";
    });
  });

  // ── Resize ───────────────────────────────────────────────────────────────
  var resizing = null, rsX = 0, rsW = 0;

  document.querySelectorAll(".resize-handle").forEach(function (h) {
    h.addEventListener("mousedown", function (e) {
      e.preventDefault(); e.stopPropagation();
      resizing = h.parentElement;
      rsX = e.clientX; rsW = resizing.offsetWidth;
      resizing.style.zIndex = "100";
    });
  });

  // ── Shared move/up ────────────────────────────────────────────────────────
  document.addEventListener("mousemove", function (e) {
    if (dragging) {
      var dx = e.clientX - smx, dy = e.clientY - smy;
      if (!didDrag && (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD)) didDrag = true;
      if (!didDrag) return;
      var cr = canvas.getBoundingClientRect();
      var x = Math.max(0, Math.min(e.clientX - cr.left - dragOX, cr.width  - dragging.offsetWidth));
      var y = Math.max(0, Math.min(e.clientY - cr.top  - dragOY, cr.height - dragging.offsetHeight));
      dragging.style.left = x + "px";
      dragging.style.top  = y + "px";
    }
    if (resizing) {
      var nw = Math.max(80, Math.min(400, rsW + (e.clientX - rsX)));
      resizing.style.width = nw + "px";
    }
  });

  document.addEventListener("mouseup", function () {
    if (dragging) {
      dragging.style.zIndex = "";
      if (didDrag) {
        var pos = getPos();
        pos[dragging.dataset.id] = { left: dragging.style.left, top: dragging.style.top, width: dragging.style.width || "" };
        savePos(pos);
      }
      var was = didDrag;
      dragging = null; didDrag = false;
      if (was) {
        document.addEventListener("click", function ab(e) {
          e.stopImmediatePropagation();
          document.removeEventListener("click", ab, true);
        }, true);
      }
    }
    if (resizing) {
      resizing.style.zIndex = "";
      var pos2 = getPos();
      pos2[resizing.dataset.id] = pos2[resizing.dataset.id] || {};
      pos2[resizing.dataset.id].left  = resizing.style.left;
      pos2[resizing.dataset.id].top   = resizing.style.top;
      pos2[resizing.dataset.id].width = resizing.style.width;
      savePos(pos2);
      resizing = null;
    }
  });

  // ── Modal ─────────────────────────────────────────────────────────────────
  var modal    = document.getElementById("proj-modal");
  var card     = document.getElementById("proj-modal-card");
  var closeBtn = document.getElementById("proj-modal-close");
  var pmTitle  = document.getElementById("pm-title");
  var pmVenue  = document.getElementById("pm-venue");
  var pmDesc   = document.getElementById("pm-desc");
  var pmMeta   = document.getElementById("pm-meta");
  var pmTags   = document.getElementById("pm-tags");
  var pmLinks  = document.getElementById("pm-links");
  var pmImage  = document.getElementById("pm-image");

  function openModal(id) {
    var d = itemMap[id]; if (!d) return;
    pmTitle.textContent = d.title;
    pmVenue.textContent = d.venue || ""; pmVenue.style.display = d.venue ? "" : "none";
    pmDesc.textContent  = d.description;
    var imgs = d.images && d.images.length ? d.images : [d.image];
    var imgContainer = pmImage.parentElement;
    imgContainer.querySelectorAll(".pm-image-extra").forEach(function(e){ e.remove(); });
    pmImage.src = imgs[0]; pmImage.alt = d.title;
    imgs.slice(1).forEach(function(src) {
      var ex = document.createElement("img");
      ex.src = src; ex.alt = d.title; ex.className = "pm-image pm-image-extra";
      imgContainer.appendChild(ex);
    });

    pmMeta.innerHTML = "";
    (d.meta || []).forEach(function (m) {
      var row = document.createElement("div"); row.className = "pm-meta-row";
      var lbl = document.createElement("span"); lbl.className = "pm-meta-label"; lbl.textContent = m.label;
      var val = document.createElement("span"); lbl.className = "pm-meta-label"; val.className = "pm-meta-value"; val.textContent = m.value;
      row.appendChild(lbl); row.appendChild(val);
      pmMeta.appendChild(row);
    });

    pmTags.innerHTML = "";
    (d.tags || []).forEach(function (t) {
      var s = document.createElement("span"); s.className = "pm-tag"; s.textContent = t;
      pmTags.appendChild(s);
    });

    pmLinks.innerHTML = "";
    if (d.links && d.links.length) {
      d.links.forEach(function (lnk) {
        var a = document.createElement("a");
        a.href = lnk.href; a.target = "_blank"; a.rel = "noopener noreferrer";
        a.className = "pm-link"; a.textContent = lnk.label;
        pmLinks.appendChild(a);
      });
    } else {
      var s2 = document.createElement("span");
      s2.className = "pm-link pm-link-muted"; s2.textContent = "Confidential";
      pmLinks.appendChild(s2);
    }
    modal.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeModal() { modal.classList.remove("open"); document.body.style.overflow = ""; }

  document.querySelectorAll(".item, .mobile-proj-item").forEach(function (el) {
    el.addEventListener("click", function () { openModal(el.dataset.id); });
  });
  modal.addEventListener("click", function (e) { if (!card.contains(e.target)) closeModal(); });
  closeBtn.addEventListener("click", closeModal);
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && modal.classList.contains("open")) closeModal();
  });
})();
</script>

<style is:global>
  /* Fill ws-main, suppress padding, use flex so proj-shell can stack */
  .ws-main {
    padding-top: 0 !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
  }

  /* JS-created modal tag/link elements need global scope */
  .pm-tag {
    font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em;
    padding: 3px 8px; border: 1px solid rgba(0,0,0,0.12);
    border-radius: 3px; color: #6b7280; display: inline-block;
  }
  .pm-link {
    font-size: 11px; padding: 5px 12px; border: 1px solid #1d1d1f;
    border-radius: 5px; color: #1d1d1f; text-decoration: none; font-weight: 500;
    letter-spacing: 0.02em; transition: background 0.15s, color 0.15s; display: inline-block;
  }
  .pm-link:hover { background: #1d1d1f; color: #fff; }
  .pm-link-muted { border-color: #ddd; color: #999; cursor: default; }
  .pm-link-muted:hover { background: transparent !important; color: #999 !important; }
</style>

<style>
  .proj-footer { flex-shrink: 0; height: 48px; }

  /* ── Shell: header + canvas stacked ────────────────────────────────────── */
  .proj-shell {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    background: #fff;
  }

  /* ── Static header ──────────────────────────────────────────────────────── */
  .proj-header {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 52px 32px 6px;
  }
  .wordmark-title {
    font-size: 28px;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #1d1d1f;
    line-height: 1;
  }
  .wordmark-sub {
    font-size: 12px;
    font-weight: 400;
    color: #7a7a7a;
    line-height: 1;
  }
  .wordmark-socials { display: flex; align-items: center; gap: 6px; }
  .wordmark-social-link {
    font-size: 12px; color: #7a7a7a;
    text-decoration: none; transition: color 0.15s;
  }
  .wordmark-social-link:hover { color: #1d1d1f; }
  .wordmark-social-sep { font-size: 12px; color: #c0c0c0; }

  /* ── Canvas fills remaining height ─────────────────────────────────────── */
  .canvas {
    flex: 1;
    position: relative;
    background-color: #ffffff;
    overflow: hidden;
  }

  /* ── Axes — limited length, centered ───────────────────────────────────── */
  .axis { position: absolute; pointer-events: none; background: rgba(0,0,0,0.28); }

