---

<Layout
  seo={{
    title: "Projects | " + identity.name,
    description: "Design, UI/UX, Research, and Engineering projects by Zayneb Cherif.",
    image: identity.logo,
  }}
>
  <script id="items-data" type="application/json" set:html={JSON.stringify(ITEMS)} />

  <div class="proj-shell">

    <!-- Static header -->
    <div class="proj-header">
      <div class="proj-header-left">
        <span class="wordmark-title">Projects</span>
        <span class="wordmark-sub">Computer Science · Design</span>
        <div class="wordmark-socials">
          <a href="https://www.linkedin.com/in/zayneb-cherif-830294251/" target="_blank" rel="noopener noreferrer" class="wordmark-social-link">LinkedIn ↗</a>
          <span class="wordmark-social-sep">·</span>
          <a href="https://github.com/zcher-20" target="_blank" rel="noopener noreferrer" class="wordmark-social-link">GitHub ↗</a>
          <span class="wordmark-social-sep">·</span>
          <a href="mailto:zaynebcheriff@gmail.com" class="wordmark-social-link">Gmail ↗</a>
        </div>
      </div>
      <div class="view-toggle" id="view-toggle">
        <button class="vt-btn active" data-view="graph">Graph</button>
        <button class="vt-btn" data-view="list">List</button>
      </div>
    </div>

  <div class="canvas" id="proj-canvas">

    <!-- Axes -->
    <div class="axis axis-h"></div>
    <div class="axis axis-v"></div>

    <!-- Axis labels -->
    <span class="al al-top">Technical</span>
    <span class="al al-bottom">Creative</span>
    <span class="al al-left">Research</span>
    <span class="al al-right">Design</span>

    <!-- Project items (hidden:true entries are excluded) -->
    {ITEMS.filter((item) => !(item as any).hidden).map((item) => (
      <div
        class="item"
        data-id={item.id}
        style={`left:${item.left};top:${item.top};width:${item.width}`}
      >
        <div class="item-img-wrap">
          <img
            src={item.image}
            alt={item.title}
            class="item-img"
            loading="lazy"
            draggable="false"
          />
          <div class="resize-handle"></div>
        </div>
        <p class="item-label">{item.shortTitle}</p>
      </div>
    ))}

  </div><!-- end canvas -->

  <!-- Mobile card list (hidden on desktop) -->
  <div class="mobile-proj-list">
    {ITEMS.filter((item) => !(item as any).hidden).map((item) => (
      <div class="mobile-proj-item" data-id={item.id}>
        <img src={item.image} alt={item.title} class="mobile-proj-img" loading="lazy" />
        <div class="mobile-proj-info">
          <p class="mobile-proj-title">{item.shortTitle}</p>
          {item.venue && <p class="mobile-proj-venue">{item.venue}</p>}
          <p class="mobile-proj-desc">{item.description}</p>
          <div class="mobile-proj-tags">
            {item.tags.map((t: string) => <span class="pm-tag">{t}</span>)}
          </div>
          <div class="mobile-proj-links">
            {item.links && item.links.length > 0
              ? item.links.map((lnk: { label: string; href: string }) => (
                  <a href={lnk.href} target="_blank" rel="noopener noreferrer" class="pm-link">{lnk.label}</a>
                ))
              : <span class="pm-link pm-link-muted">Confidential</span>
            }
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- ── List view ── -->
  <div class="list-view" id="proj-list-view">
    {(["work", "research", "design"] as const).map((sec) => (
      <div class="lv-section">
        <h2 class="lv-section-title">{sec === "work" ? "Work" : sec === "research" ? "Research" : "Design"}</h2>
        <div class="lv-grid">
          {ITEMS.filter((item) => !(item as any).hidden && (item as any).section === sec).map((item) => (
            <div class="lv-card" data-id={item.id}>
              <div class="lv-img-wrap">
                <img src={item.image} alt={item.shortTitle} class="lv-img" loading="lazy" />
              </div>
              <div class="lv-info">
                <p class="lv-title">{item.shortTitle}</p>
                {item.venue && <p class="lv-venue">{item.venue}</p>}
                <p class="lv-year">{(item as any).year}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

    <!-- Detail modal -->
    <div id="proj-modal" class="modal" role="dialog" aria-modal="true">
      <button class="cs-nav-btn" id="cs-nav-prev"><svg width="8" height="13" viewBox="0 0 8 13" fill="none"><path d="M7 1L1 6.5L7 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="modal-card" id="proj-modal-card">

        <!-- Top bar: visit-site right -->
        <div class="cs-topbar">
          <a id="cs-visit-btn" class="cs-visit-btn" href="#" target="_blank" rel="noopener noreferrer">Visit Site ↗</a>
        </div>

        <!-- Title / venue / description -->
        <div class="cs-header">
          <img id="cs-logo" class="cs-logo" src="" alt="" />
          <h2 class="cs-title">
            <span id="cs-title-text"></span><span class="cs-title-sep"> · </span><span id="cs-title-year" class="cs-title-year"></span>
          </h2>
          <p id="cs-venue" class="cs-venue"></p>
          <p id="cs-desc" class="cs-desc"></p>
        </div>

        <!-- Tech-stack columns (filled by JS) -->
        <div id="cs-stack" class="cs-stack"></div>

        <!-- Project image(s) (filled by JS) -->
        <div id="cs-images" class="cs-images"></div>

        <!-- Also check out (filled by JS) -->
        <div id="cs-also" class="cs-also"></div>

      </div>
      <button class="cs-nav-btn" id="cs-nav-next"><svg width="8" height="13" viewBox="0 0 8 13" fill="none"><path d="M1 1L7 6.5L1 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>

  <div class="proj-footer"></div>
  </div><!-- end proj-shell -->
</Layout>

<script is:inline>
(function () {
  var STORAGE_KEY = "proj-positions-v4";

  // ── Password gate ─────────────────────────────────────────────────────────
  var CASE_STUDY_PW = "zayneb"; // change to your preferred password

  function showPwGate(container, d, onUnlock) {
    var gate = document.createElement("div");
    gate.className = "cs-pw-gate";
    gate.innerHTML =
      '<div class="cs-pw-icon-wrap"><svg viewBox="0 0 24 24" fill="currentColor" class="cs-pw-lock"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></div>' +
      '<p class="cs-pw-title">This case study is password-protected.</p>' +
      '<p class="cs-pw-sub">Curious? Feel free to <a href="mailto:zaynebcheriff@gmail.com" class="cs-pw-email">email me!</a></p>' +
      '<div class="cs-pw-form"><input type="password" class="cs-pw-input" placeholder="Enter" /><button class="cs-pw-btn" aria-label="Submit">&#x2192;</button></div>' +
      '<p class="cs-pw-error"></p>';
    container.appendChild(gate);
    var input  = gate.querySelector(".cs-pw-input");
    var btn    = gate.querySelector(".cs-pw-btn");
    var errEl  = gate.querySelector(".cs-pw-error");
    function tryUnlock() {
      if (input.value === CASE_STUDY_PW) { onUnlock(); }
      else { errEl.textContent = "Incorrect password."; input.value = ""; input.focus(); }
    }
    btn.addEventListener("click", tryUnlock);
    input.addEventListener("keydown", function (e) { if (e.key === "Enter") tryUnlock(); });
  }

  function getPos()     { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); } catch { return {}; } }
  function savePos(pos) { localStorage.setItem(STORAGE_KEY, JSON.stringify(pos)); }

  function init() {
    var rawData = document.getElementById("items-data");
    if (!rawData) return;
    var ITEMS = JSON.parse(rawData.textContent);
    var itemMap = {};
    ITEMS.forEach(function (d) { itemMap[d.id] = d; });

    var canvas = document.getElementById("proj-canvas");
    if (!canvas) return;

    // ── Restore saved px positions ────────────────────────────────────────
    var pos = getPos();
    document.querySelectorAll(".item").forEach(function (el) {
      var saved = pos[el.dataset.id];
      if (saved) {
        if (saved.left)  el.style.left  = saved.left;
        if (saved.top)   el.style.top   = saved.top;
        if (saved.width) el.style.width = saved.width;
      }
    });

    // ── Drag ─────────────────────────────────────────────────────────────
    var dragging = null, dragOX = 0, dragOY = 0, smx = 0, smy = 0, didDrag = false;
    var THRESHOLD = 5;

    document.querySelectorAll(".item").forEach(function (el) {
      el.addEventListener("mousedown", function (e) {
        if (e.button !== 0 || e.target.classList.contains("resize-handle")) return;
        e.preventDefault();
        if (el.style.left.indexOf('%') !== -1 || el.style.top.indexOf('%') !== -1) {
          var cr = canvas.getBoundingClientRect();
          var er = el.getBoundingClientRect();
          el.style.left = (er.left - cr.left) + "px";
          el.style.top  = (er.top  - cr.top)  + "px";
        }
        dragging = el; didDrag = false; smx = e.clientX; smy = e.clientY;
        var r = el.getBoundingClientRect();
        dragOX = e.clientX - r.left; dragOY = e.clientY - r.top;
        el.style.zIndex = "100";
      });
    });

    // ── Resize ───────────────────────────────────────────────────────────
    var resizing = null, rsX = 0, rsW = 0;

    document.querySelectorAll(".resize-handle").forEach(function (h) {
      h.addEventListener("mousedown", function (e) {
        e.preventDefault(); e.stopPropagation();
        resizing = h.parentElement;
        rsX = e.clientX; rsW = resizing.offsetWidth;
        resizing.style.zIndex = "100";
      });
    });

    // ── Shared move/up ────────────────────────────────────────────────────
    function onMouseMove(e) {
      if (dragging) {
        var dx = e.clientX - smx, dy = e.clientY - smy;
        if (!didDrag && (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD)) didDrag = true;
        if (!didDrag) return;
        var cr = canvas.getBoundingClientRect();
        var x = Math.max(0, Math.min(e.clientX - cr.left - dragOX, cr.width  - dragging.offsetWidth));
        var y = Math.max(0, Math.min(e.clientY - cr.top  - dragOY, cr.height - dragging.offsetHeight));
        dragging.style.left = x + "px";
        dragging.style.top  = y + "px";
      }
      if (resizing) {
        var nw = Math.max(80, Math.min(400, rsW + (e.clientX - rsX)));
        resizing.style.width = nw + "px";
      }
    }

    function onMouseUp() {
      if (dragging) {
        dragging.style.zIndex = "";
        if (didDrag) {
          var pos = getPos();
          pos[dragging.dataset.id] = { left: dragging.style.left, top: dragging.style.top, width: dragging.style.width || "" };
          savePos(pos);
        }
        var was = didDrag;
        dragging = null; didDrag = false;
        if (was) {
          document.addEventListener("click", function ab(e) {
            e.stopImmediatePropagation();
            document.removeEventListener("click", ab, true);
          }, true);
        }
      }
      if (resizing) {
        resizing.style.zIndex = "";
        var pos2 = getPos();
        pos2[resizing.dataset.id] = pos2[resizing.dataset.id] || {};
        pos2[resizing.dataset.id].left  = resizing.style.left;
        pos2[resizing.dataset.id].top   = resizing.style.top;
        pos2[resizing.dataset.id].width = resizing.style.width;
        savePos(pos2);
        resizing = null;
      }
    }

    document.addEventListener("mousemove", onMouseMove);
    document.addEventListener("mouseup", onMouseUp);

    // ── View toggle ───────────────────────────────────────────────────────
    var canvas2   = document.getElementById("proj-canvas");
    var listView  = document.getElementById("proj-list-view");
    var toggleBtns = document.querySelectorAll(".vt-btn");
    var VIEW_KEY  = "proj-view";

    function setView(v) {
      var isGraph = v !== "list";
      canvas2.style.display  = isGraph ? "" : "none";
      listView.style.display = isGraph ? "none" : "block";
      var wsMain = document.querySelector(".ws-main");
      if (wsMain) wsMain.classList.toggle("list-mode", !isGraph);
      toggleBtns.forEach(function (b) {
        b.classList.toggle("active", b.dataset.view === v);
      });
      localStorage.setItem(VIEW_KEY, v);
    }

    toggleBtns.forEach(function (btn) {
      btn.addEventListener("click", function () { setView(btn.dataset.view); });
    });

    var savedView = localStorage.getItem(VIEW_KEY) || "graph";
    setView(savedView);

    // ── Modal ─────────────────────────────────────────────────────────────
    var modal    = document.getElementById("proj-modal");
    var card     = document.getElementById("proj-modal-card");
    var csTitleText = document.getElementById("cs-title-text");
    var csTitleYear = document.getElementById("cs-title-year");
    var csVenue     = document.getElementById("cs-venue");
    var csDesc      = document.getElementById("cs-desc");
    var csVisitBtn  = document.getElementById("cs-visit-btn");
    var csLogo      = document.getElementById("cs-logo");
    var csStack     = document.getElementById("cs-stack");
    var csImages    = document.getElementById("cs-images");
    var csNavPrev   = document.getElementById("cs-nav-prev");
    var csNavNext   = document.getElementById("cs-nav-next");
    var currentId   = null;
    var navIds      = ITEMS.filter(function (it) { return !it.hidden; }).map(function (it) { return it.id; });

    function updateNavBtns(id) {
      var idx = navIds.indexOf(id);
      csNavPrev.style.opacity = idx > 0 ? "" : "0.15";
      csNavPrev.style.pointerEvents = idx > 0 ? "" : "none";
      csNavNext.style.opacity = idx < navIds.length - 1 ? "" : "0.15";
      csNavNext.style.pointerEvents = idx < navIds.length - 1 ? "" : "none";
    }

    function openModal(id) {
      var d = itemMap[id]; if (!d) return;
      currentId = id;

      if (d.logo) {
        csLogo.src = d.logo; csLogo.alt = d.venue || d.title;
        csLogo.style.height = d.logoHeight || "36px";
        csLogo.style.marginLeft = d.logoOffset || "0px";
        csLogo.style.display = "";
      } else {
        csLogo.style.display = "none";
      }
      csTitleText.textContent = d.title;
      csTitleYear.textContent = d.year || "";
      csVenue.textContent = d.venue || "";
      csVenue.style.display = d.venue ? "" : "none";
      csDesc.textContent = d.description;

      // Visit button — label depends on link type and project section
      var firstLink = d.links && d.links.length ? d.links[0] : null;
      if (firstLink) {
        csVisitBtn.href = firstLink.href;
        var isGithub = firstLink.href.indexOf("github.com") !== -1;
        var isResearch = d.section === "research";
        csVisitBtn.textContent = isResearch ? "View Publication ↗" : isGithub ? "Visit Repo ↗" : "Visit Site ↗";
        csVisitBtn.style.display = "";
      } else {
        csVisitBtn.style.display = "none";
      }

      // Stack columns — from meta (split " · "), else from tags
      csStack.innerHTML = "";
      if (d.meta && d.meta.length) {
        d.meta.forEach(function (m) {
          var col = document.createElement("div");
          col.className = "cs-col";
          var lbl = document.createElement("span");
          lbl.className = "cs-col-label";
          lbl.textContent = m.label;
          col.appendChild(lbl);
          m.value.split(" · ").forEach(function (item) {
            var p = document.createElement("p");
            p.className = "cs-col-item";
            p.textContent = item.trim();
            col.appendChild(p);
          });
          csStack.appendChild(col);
        });
      } else if (d.tags && d.tags.length) {
        var col = document.createElement("div");
        col.className = "cs-col";
        var lbl = document.createElement("span");
        lbl.className = "cs-col-label";
        lbl.textContent = "Stack";
        col.appendChild(lbl);
        d.tags.forEach(function (t) {
          var p = document.createElement("p");
          p.className = "cs-col-item";
          p.textContent = t;
          col.appendChild(p);
        });
        csStack.appendChild(col);
      }

      // Images (or password gate for confidential projects)
      csImages.innerHTML = "";
      if (d.confidential) {
        showPwGate(csImages, d, function () {
          csImages.innerHTML = "";
          var imgs2 = d.images && d.images.length ? d.images : [d.image];
          imgs2.forEach(function (src) {
            var img = document.createElement("img");
            img.src = src; img.alt = d.title; img.className = "cs-image";
            csImages.appendChild(img);
          });
        });
        // Always show cover image below the gate
        var coverImg = document.createElement("img");
        coverImg.src = d.image; coverImg.alt = d.title;
        coverImg.className = "cs-image cs-pw-cover";
        csImages.appendChild(coverImg);
      } else {
        var imgs = d.images && d.images.length ? d.images : [d.image];
        imgs.forEach(function (src) {
          var img = document.createElement("img");
          img.src = src; img.alt = d.title; img.className = "cs-image";
          csImages.appendChild(img);
        });
      }

      // Also check out — same section, random picks
      var csAlso = document.getElementById("cs-also");
      csAlso.innerHTML = "";
      var others = ITEMS.filter(function (it) { return !it.hidden && it.id !== d.id && it.section === d.section; });
      for (var ai = others.length - 1; ai > 0; ai--) {
        var aj = Math.floor(Math.random() * (ai + 1));
        var tmp = others[ai]; others[ai] = others[aj]; others[aj] = tmp;
      }
      var picks = others.slice(0, 2);
      if (picks.length) {
        var alsoLabel = document.createElement("p");
        alsoLabel.className = "cs-also-label";
        alsoLabel.textContent = "Also check out...";
        csAlso.appendChild(alsoLabel);
        var alsoGrid = document.createElement("div");
        alsoGrid.className = "cs-also-grid";
        picks.forEach(function (p) {
          var ac = document.createElement("div");
          ac.className = "cs-also-card";
          var aImg = document.createElement("img");
          aImg.src = p.image; aImg.alt = p.shortTitle || p.title;
          aImg.className = "cs-also-img";
          var aMeta = document.createElement("p");
          aMeta.className = "cs-also-meta";
          aMeta.innerHTML = "<strong>" + (p.shortTitle || p.title) + "</strong><span class='cs-also-dot'> • </span><span class='cs-also-yr'>" + (p.year || "") + "</span>";
          ac.appendChild(aImg); ac.appendChild(aMeta);
          (function (id) { ac.addEventListener("click", function (e) { e.stopPropagation(); openModal(id); }); })(p.id);
          alsoGrid.appendChild(ac);
        });
        csAlso.appendChild(alsoGrid);
      }

      modal.classList.add("open");
      document.body.style.overflow = "hidden";
      card.scrollTop = 0;
      updateNavBtns(id);
    }

    function closeModal() { modal.classList.remove("open"); document.body.style.overflow = ""; }

    csNavPrev.addEventListener("click", function (e) {
      e.stopPropagation();
      var idx = navIds.indexOf(currentId);
      if (idx > 0) openModal(navIds[idx - 1]);
    });
    csNavNext.addEventListener("click", function (e) {
      e.stopPropagation();
      var idx = navIds.indexOf(currentId);
      if (idx < navIds.length - 1) openModal(navIds[idx + 1]);
    });

    function onKeyDown(e) {
      if (!modal.classList.contains("open")) return;
      if (e.key === "Escape") closeModal();
      if (e.key === "ArrowLeft") { var i = navIds.indexOf(currentId); if (i > 0) openModal(navIds[i - 1]); }
      if (e.key === "ArrowRight") { var i = navIds.indexOf(currentId); if (i < navIds.length - 1) openModal(navIds[i + 1]); }
    }

    document.querySelectorAll(".item, .mobile-proj-item, .lv-card").forEach(function (el) {
      el.addEventListener("click", function () { openModal(el.dataset.id); });
    });
    modal.addEventListener("click", function (e) {
      if (!card.contains(e.target) && e.target !== csNavPrev && e.target !== csNavNext) closeModal();
    });
    document.addEventListener("keydown", onKeyDown);

    // ── Cleanup before next navigation ────────────────────────────────────
    document.addEventListener("astro:before-swap", function cleanup() {
      document.removeEventListener("mousemove", onMouseMove);
      document.removeEventListener("mouseup", onMouseUp);
      document.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("astro:before-swap", cleanup);
    });
  }

  document.addEventListener("astro:page-load", init);
})();
</script>

<style is:global>
  /* Fill ws-main, suppress padding, use flex so proj-shell can stack */
  .ws-main {
    padding-top: 0 !important;
    overflow-y: auto !important;
    display: flex !important;
    flex-direction: column !important;
  }
  /* proj-shell never shrinks — always fills viewport, footer scrolls into view below */
  .proj-shell { flex-shrink: 0 !important; }
  /* In list mode, collapse shell height so footer follows content */
  .ws-main.list-mode .proj-shell { height: auto !important; flex-shrink: 1 !important; }
  /* List view needs scrolling — toggled by JS on ws-main */
  .ws-main.list-mode { overflow-y: auto !important; }
  @media (max-width: 768px) {
    .ws-main { overflow-y: auto !important; }
  }

  /* JS-created modal tag/link elements need global scope */
  .pm-tag {
    font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em;
