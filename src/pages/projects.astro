  .cs-pw-form {
    display: flex; align-items: center; background: #fff;
    border-radius: 100px; padding: 10px 14px 10px 20px;
    width: fit-content; min-width: 260px; gap: 8px;
  }
  .cs-pw-input {
    border: none; outline: none; background: none;
