<script is:inline>
(function () {
  function initHomeExpToggle() {
    var btnHoriz = document.getElementById("home-btn-horiz");
    var btnList  = document.getElementById("home-btn-list");
    var tlHoriz  = document.getElementById("home-tl-horiz");
    var expList  = document.getElementById("home-exp-list");
    if (!btnHoriz || !btnList) return;

    function showHoriz() {
      tlHoriz.style.display = "block";
      expList.style.display = "none";
      btnHoriz.classList.add("is-active");
      btnList.classList.remove("is-active");
      localStorage.setItem("home-exp-view", "horiz");
    }
    function showList() {
      tlHoriz.style.display = "none";
      expList.style.display = "block";
      btnHoriz.classList.remove("is-active");
      btnList.classList.add("is-active");
      localStorage.setItem("home-exp-view", "list");
    }

    btnHoriz.addEventListener("click", showHoriz);
    btnList.addEventListener("click", showList);

    if (localStorage.getItem("home-exp-view") === "list") showList();
  }

  document.addEventListener("astro:page-load", initHomeExpToggle);
  initHomeExpToggle();
})();
</script>
