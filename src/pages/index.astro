            '<div style="display:flex; align-items:center; gap:8px; font-size:13px; opacity:0.85; font-weight:500;"><span style="width:6px;height:6px;border-radius:50%;background:#0050d8;flex-shrink:0;display:inline-block;"></span><span>Project breakdown · 8 modules</span></div>' +
