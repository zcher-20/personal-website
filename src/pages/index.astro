        imgs.forEach(function (src) {
          var img = document.createElement("img");
          img.src = src; img.alt = d.title; img.className = "hpm-cs-image";
          if (d.grayscaleImage) img.style.filter = "grayscale(100%)";
          hpmImages.appendChild(img);
        });
      }
    }

    modal.classList.add("open");
    document.body.style.overflow = "hidden";
    card.scrollTop = 0;
    updateNavBtns(id);
  }

  function closeModal() { modal.classList.remove("open"); document.body.style.overflow = ""; }

  function initModalCards() {
    document.querySelectorAll(".home-proj-card").forEach(function (el) {
      el.addEventListener("click", function () { openModal(el.dataset.id); });
    });
  }

  hpmNavPrev.addEventListener("click", function (e) {
    e.stopPropagation();
    var idx = navIds.indexOf(currentId);
    if (idx > 0) openModal(navIds[idx - 1]);
  });
  hpmNavNext.addEventListener("click", function (e) {
    e.stopPropagation();
    var idx = navIds.indexOf(currentId);
    if (idx < navIds.length - 1) openModal(navIds[idx + 1]);
  });

  modal.addEventListener("click", function (e) {
    if (!card.contains(e.target) && e.target !== hpmNavPrev && e.target !== hpmNavNext) closeModal();
  });
  document.addEventListener("keydown", function (e) {
    if (!modal.classList.contains("open")) return;
    if (e.key === "Escape") closeModal();
    if (e.key === "ArrowLeft") { var i = navIds.indexOf(currentId); if (i > 0) openModal(navIds[i - 1]); }
    if (e.key === "ArrowRight") { var i = navIds.indexOf(currentId); if (i < navIds.length - 1) openModal(navIds[i + 1]); }
  });

  document.addEventListener("astro:page-load", initModalCards);
  initModalCards();

})();
</script>

