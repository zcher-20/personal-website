        previewCard.addEventListener("click", function(e) { e.stopPropagation(); });
        previewCard.innerHTML = '<p style="font-size:16px; font-weight:700; line-height:1.4; margin:0 0 16px;">' + (d.shortTitle || d.title) + ' — Case Study</p>' +
          '<div style="display:flex; flex-direction:column; gap:8px; flex:1;">' +
