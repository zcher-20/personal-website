<script is:inline>
  (function () {
    var sidebar     = document.getElementById("app-sidebar");
    var toggleBtn   = document.getElementById("sidebar-toggle-btn");
    var iconClose   = document.getElementById("toggle-icon-close");
    var iconOpen    = document.getElementById("toggle-icon-open");
    var flyout      = document.getElementById("sidebar-flyout");
    var archiveMain = document.getElementById("archive-main");

    function collapse() {
      sidebar.classList.remove("open");
      sidebar.classList.add("collapsed");
      iconClose.classList.add("hidden");
      iconOpen.classList.remove("hidden");
    }
    function expand() {
      sidebar.classList.remove("collapsed");
      sidebar.classList.add("open");
      iconClose.classList.remove("hidden");
      iconOpen.classList.add("hidden");
      flyout.classList.add("hidden");
    }

    toggleBtn.addEventListener("click", function () {
      sidebar.classList.contains("open") ? collapse() : expand();
    });

    var flyoutTimer;
    sidebar.addEventListener("mouseenter", function () {
      if (!sidebar.classList.contains("collapsed")) return;
      clearTimeout(flyoutTimer);
      flyout.classList.remove("hidden");
    });
    sidebar.addEventListener("mouseleave", function () {
      if (!sidebar.classList.contains("collapsed")) return;
      flyoutTimer = setTimeout(function () { flyout.classList.add("hidden"); }, 150);
    });
    flyout.addEventListener("mouseenter", function () { clearTimeout(flyoutTimer); });
    flyout.addEventListener("mouseleave", function () {
      flyoutTimer = setTimeout(function () { flyout.classList.add("hidden"); }, 150);
    });

    // Smooth scroll to anchored sections
    document.querySelectorAll(".section-scroll-link").forEach(function (link) {
      link.addEventListener("click", function (e) {
        var targetId = link.getAttribute("data-target");
        var section = document.getElementById(targetId);
        if (section && archiveMain) {
          e.preventDefault();
          var sectionTop = section.getBoundingClientRect().top
            - archiveMain.getBoundingClientRect().top
            + archiveMain.scrollTop;
          var offset = (archiveMain.clientHeight / 2) - (section.offsetHeight / 2);
          var target = sectionTop - Math.max(offset, 0);
          archiveMain.scrollTo({ top: target, behavior: "smooth" });
        }
        // Immediately update active highlight
        document.querySelectorAll("#home-app-nav .app-nav-btn").forEach(function (b) { b.classList.remove("active"); });
        link.classList.add("active");
        if (flyout) flyout.classList.add("hidden");
      });
    });

    // Active nav highlight based on visible section
    var sectionIds = ["about", "projects", "experience"];
    var sectionObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var id = entry.target.id;
        var link = document.querySelector("#home-app-nav [data-section='" + id + "']");
        var homeLink = document.querySelector("#home-app-nav [href='/']");
        if (!link) return;
        if (entry.isIntersecting) {
          document.querySelectorAll("#home-app-nav .app-nav-btn").forEach(function (b) { b.classList.remove("active"); });
          link.classList.add("active");
        } else {
          link.classList.remove("active");
          var anyActive = document.querySelector("#home-app-nav .app-nav-btn.active");
          if (!anyActive && homeLink) homeLink.classList.add("active");
        }
      });
    }, { root: archiveMain, threshold: 0.3 });

    sectionIds.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });
  })();
</script>

<script is:inline>
(function () {
  var CASE_STUDY_PW = "zayneb"; // change to your preferred password

  function renderPdfViewer(container, pdfUrl) {
    var wrap = document.createElement("div");
    wrap.style.cssText = "margin-top:20px; border:1px solid rgba(0,0,0,0.1); border-radius:12px; overflow:hidden; background:#f5f5f7;";

    var canvasWrap = document.createElement("div");
    canvasWrap.style.cssText = "overflow-y:auto; max-height:480px; padding:16px; display:flex; flex-direction:column; gap:12px; align-items:center;";

    var nav = document.createElement("div");
    nav.style.cssText = "display:flex; align-items:center; justify-content:center; gap:16px; padding:10px 16px; border-top:1px solid rgba(0,0,0,0.08); background:#fff;";

    var prevBtn = document.createElement("button");
    prevBtn.textContent = "←";
    prevBtn.style.cssText = "background:none; border:1px solid #ddd; border-radius:6px; padding:4px 14px; cursor:pointer; font-size:14px; color:#444;";

    var pageInfo = document.createElement("span");
    pageInfo.style.cssText = "font-size:12px; opacity:0.5; min-width:50px; text-align:center;";
    pageInfo.textContent = "…";

    var nextBtn = document.createElement("button");
    nextBtn.textContent = "→";
    nextBtn.style.cssText = "background:none; border:1px solid #ddd; border-radius:6px; padding:4px 14px; cursor:pointer; font-size:14px; color:#444;";

    nav.appendChild(prevBtn); nav.appendChild(pageInfo); nav.appendChild(nextBtn);
    wrap.appendChild(canvasWrap); wrap.appendChild(nav);
    container.appendChild(wrap);

    var pdfDoc = null, currentPage = 1, rendering = false;

    function loadPdfJs(cb) {
      if (window.pdfjsLib) { cb(); return; }
      var s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
      s.onload = function() {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        cb();
      };
      document.head.appendChild(s);
    }

    function renderPage(num) {
      if (!pdfDoc || rendering) return;
      rendering = true;
      pdfDoc.getPage(num).then(function(page) {
        var dpr = window.devicePixelRatio || 1;
        var scale = (canvasWrap.clientWidth - 32) / page.getViewport({ scale: 1 }).width;
        var vp = page.getViewport({ scale: scale * dpr });
        var canvas = document.createElement("canvas");
        canvas.width = vp.width; canvas.height = vp.height;
        canvas.style.cssText = "border-radius:6px; box-shadow:0 2px 8px rgba(0,0,0,0.1); max-width:100%; width:" + (vp.width / dpr) + "px; height:" + (vp.height / dpr) + "px;";
        canvasWrap.innerHTML = "";
        canvasWrap.appendChild(canvas);
        page.render({ canvasContext: canvas.getContext("2d"), viewport: vp }).promise.then(function() {
          rendering = false;
          pageInfo.textContent = num + " / " + pdfDoc.numPages;
          prevBtn.style.opacity = num <= 1 ? "0.3" : "1";
          nextBtn.style.opacity = num >= pdfDoc.numPages ? "0.3" : "1";
        });
      });
    }

    prevBtn.addEventListener("click", function(e) { e.stopPropagation(); if (currentPage > 1) { currentPage--; renderPage(currentPage); } });
    nextBtn.addEventListener("click", function(e) { e.stopPropagation(); if (pdfDoc && currentPage < pdfDoc.numPages) { currentPage++; renderPage(currentPage); } });

    loadPdfJs(function() {
      window.pdfjsLib.getDocument(pdfUrl).promise.then(function(doc) {
        pdfDoc = doc;
        renderPage(1);
      });
    });
  }

  function showPwGate(container, onUnlock) {
    var gate = document.createElement("div");
    gate.className = "hpm-pw-gate";
    gate.innerHTML =
      '<div class="hpm-pw-icon-wrap"><svg viewBox="0 0 24 24" fill="currentColor" class="hpm-pw-lock"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></div>' +
      '<p class="hpm-pw-title">This case study is password-protected.</p>' +
      '<p class="hpm-pw-sub">Curious? Feel free to <a href="mailto:zaynebcheriff@gmail.com" class="hpm-pw-email">email me!</a></p>' +
      '<div class="hpm-pw-form"><input type="password" class="hpm-pw-input" placeholder="Enter" /><button class="hpm-pw-btn" aria-label="Submit">&#x2192;</button></div>' +
      '<p class="hpm-pw-error"></p>';
    container.appendChild(gate);
    var input = gate.querySelector(".hpm-pw-input");
    var btn   = gate.querySelector(".hpm-pw-btn");
    var errEl = gate.querySelector(".hpm-pw-error");
    function tryUnlock() {
      if (input.value === CASE_STUDY_PW) { onUnlock(); }
      else { errEl.textContent = "Incorrect password."; input.value = ""; input.focus(); }
    }
    btn.addEventListener("click", tryUnlock);
    input.addEventListener("keydown", function (e) { if (e.key === "Enter") tryUnlock(); });
  }

  var rawData = document.getElementById("home-proj-data");
  if (!rawData) return;
  var ITEMS = JSON.parse(rawData.textContent);
  var itemMap = {};
  ITEMS.forEach(function (d) { itemMap[d.id] = d; });

  var modal      = document.getElementById("home-proj-modal");
  var card       = document.getElementById("home-modal-card");
  var hpmVisitBtn  = document.getElementById("hpm-visit-btn");
  var hpmLogo      = document.getElementById("hpm-logo");
  var hpmTitleText = document.getElementById("hpm-title-text");
  var hpmTitleYear = document.getElementById("hpm-title-year");
  var hpmVenue     = document.getElementById("hpm-venue");
  var hpmDesc      = document.getElementById("hpm-desc");
  var hpmStack     = document.getElementById("hpm-stack");
  var hpmImages    = document.getElementById("hpm-images");
  var hpmNavPrev   = document.getElementById("hpm-nav-prev");
  var hpmNavNext   = document.getElementById("hpm-nav-next");
  var currentId  = null;
  var navIds     = [];

  function updateNavBtns(id) {
    navIds = Array.from(document.querySelectorAll(".home-proj-card")).map(function (el) { return el.dataset.id; });
    var idx = navIds.indexOf(id);
    hpmNavPrev.style.opacity = idx > 0 ? "" : "0.15";
    hpmNavPrev.style.pointerEvents = idx > 0 ? "" : "none";
    hpmNavNext.style.opacity = idx < navIds.length - 1 ? "" : "0.15";
    hpmNavNext.style.pointerEvents = idx < navIds.length - 1 ? "" : "none";
    hpmNavPrev.style.display = navIds.length > 1 ? "" : "none";
    hpmNavNext.style.display = navIds.length > 1 ? "" : "none";
  }

  function openModal(id) {
    var d = itemMap[id]; if (!d) return;
    currentId = id;

    if (d.logo) {
      hpmLogo.src = d.logo; hpmLogo.alt = d.venue || d.title;
      hpmLogo.style.height = d.logoHeight || "36px";
      hpmLogo.style.marginLeft = d.logoOffset || "0px";
      hpmLogo.style.display = "";
    } else {
      hpmLogo.style.display = "none";
    }
    hpmTitleText.textContent = d.title;
    hpmTitleYear.textContent = d.year || "";
    hpmVenue.textContent = d.venue || "";
    hpmVenue.style.display = d.venue ? "" : "none";
    hpmDesc.textContent = d.description;

    var firstLink = d.links && d.links.length ? d.links[0] : null;
    if (firstLink) {
      hpmVisitBtn.href = firstLink.href;
      hpmVisitBtn.textContent = firstLink.label || "Visit ↗";
      hpmVisitBtn.style.display = "";
    } else {
      hpmVisitBtn.style.display = "none";
    }

    hpmStack.innerHTML = "";
    if (d.meta && d.meta.length) {
      d.meta.forEach(function (m) {
        var col = document.createElement("div"); col.className = "hpm-cs-col";
        var lbl = document.createElement("span"); lbl.className = "hpm-cs-col-label"; lbl.textContent = m.label;
        col.appendChild(lbl);
        m.value.split(" · ").forEach(function (item) {
