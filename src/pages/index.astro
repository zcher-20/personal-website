          </div>
        </section>

        <!-- Experience section -->
        <section id="experience" class="exp-section">
          <h2 class="exp-heading">Experience</h2>
          {EXPERIENCE.map((job) => (
            <div class="exp-row">
              <div class="exp-logo">
                <img src={job.company.image} alt={job.company.name} draggable="false" />
              </div>
              <div class="exp-content">
                <p class="exp-title">{job.title}</p>
                <p class="exp-company-name">{job.company.name}</p>
                {job.cleanDesc && <p class="exp-desc">{job.cleanDesc}</p>}
              </div>
              <div class="exp-date">{job.date}</div>
            </div>
          ))}
        </section>

        <!-- Projects section -->
        <section id="projects" class="home-proj-section">
          <div class="home-proj-header">
            <h2 class="exp-heading">Highlighted Projects</h2>
            <a href="/projects" class="view-all-link">View all →</a>
          </div>
          <script id="home-proj-data" type="application/json" set:html={JSON.stringify(PROJECTS)} />
          <div class="home-proj-grid">
            {PROJECTS.map((item) => (
              <div class="home-proj-card" data-id={item.id}>
                <div class="home-proj-img-wrap">
                  <img src={item.image} alt={item.title} loading="lazy" draggable="false" />
                </div>
                <p class="home-proj-title">{item.shortTitle}</p>
                {item.venue && <p class="home-proj-venue">{item.venue}</p>}
                <p class="home-proj-desc">{item.description}</p>
                <div class="home-proj-tags">
                  {item.tags.map((t: string) => <span class="home-proj-tag">{t}</span>)}
                </div>
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>

  </div>

  <!-- Projects modal -->
  <div id="home-proj-modal" class="home-modal" role="dialog" aria-modal="true">
    <div class="home-modal-card" id="home-modal-card">
      <button id="home-modal-close" class="home-modal-close" aria-label="Close">&#x2715;</button>
      <div class="home-modal-left">
        <h2 id="hpm-title" class="hpm-title"></h2>
        <p id="hpm-venue" class="hpm-venue"></p>
        <p id="hpm-desc" class="hpm-desc"></p>
        <div id="hpm-meta" class="hpm-meta"></div>
        <div id="hpm-tags" class="hpm-tags"></div>
        <div id="hpm-links" class="hpm-links"></div>
      </div>
      <div class="home-modal-right">
        <img id="hpm-image" class="hpm-image" src="" alt="" />
      </div>
    </div>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav">
    {MOBILE_NAV.map((item) => (
      <a href={item.href} class={`mobile-nav-btn${item.href === "/" ? " mobile-nav-active" : ""}`}>
        <Icon name={item.icon} class="mobile-nav-icon" />
        <span class="mobile-nav-label">{item.label}</span>
      </a>
    ))}
  </nav>

</Layout>

<script is:inline>
  (function () {
    var sidebar     = document.getElementById("app-sidebar");
    var toggleBtn   = document.getElementById("sidebar-toggle-btn");
    var iconClose   = document.getElementById("toggle-icon-close");
    var iconOpen    = document.getElementById("toggle-icon-open");
    var flyout      = document.getElementById("sidebar-flyout");
    var archiveMain = document.getElementById("archive-main");

    function collapse() {
      sidebar.classList.remove("open");
      sidebar.classList.add("collapsed");
      iconClose.classList.add("hidden");
      iconOpen.classList.remove("hidden");
    }
    function expand() {
      sidebar.classList.remove("collapsed");
      sidebar.classList.add("open");
      iconClose.classList.remove("hidden");
      iconOpen.classList.add("hidden");
      flyout.classList.add("hidden");
    }

    toggleBtn.addEventListener("click", function () {
      sidebar.classList.contains("open") ? collapse() : expand();
    });

    var flyoutTimer;
    sidebar.addEventListener("mouseenter", function () {
      if (!sidebar.classList.contains("collapsed")) return;
      clearTimeout(flyoutTimer);
      flyout.classList.remove("hidden");
    });
    sidebar.addEventListener("mouseleave", function () {
      if (!sidebar.classList.contains("collapsed")) return;
      flyoutTimer = setTimeout(function () { flyout.classList.add("hidden"); }, 150);
    });
    flyout.addEventListener("mouseenter", function () { clearTimeout(flyoutTimer); });
    flyout.addEventListener("mouseleave", function () {
      flyoutTimer = setTimeout(function () { flyout.classList.add("hidden"); }, 150);
    });

    // Smooth scroll to anchored sections
    document.querySelectorAll(".section-scroll-link").forEach(function (link) {
      link.addEventListener("click", function (e) {
        var targetId = link.getAttribute("data-target");
        var section = document.getElementById(targetId);
        if (section && archiveMain) {
          e.preventDefault();
          var target = section.getBoundingClientRect().top
            - archiveMain.getBoundingClientRect().top
            + archiveMain.scrollTop;
          archiveMain.scrollTo({ top: target, behavior: "smooth" });
        }
        if (flyout) flyout.classList.add("hidden");
      });
    });
  })();
</script>

<script is:inline>
(function () {
  var rawData = document.getElementById("home-proj-data");
  if (!rawData) return;
  var ITEMS = JSON.parse(rawData.textContent);
  var itemMap = {};
  ITEMS.forEach(function (d) { itemMap[d.id] = d; });

  var modal    = document.getElementById("home-proj-modal");
  var card     = document.getElementById("home-modal-card");
  var closeBtn = document.getElementById("home-modal-close");
  var hpmTitle  = document.getElementById("hpm-title");
  var hpmVenue  = document.getElementById("hpm-venue");
  var hpmDesc   = document.getElementById("hpm-desc");
  var hpmMeta   = document.getElementById("hpm-meta");
  var hpmTags   = document.getElementById("hpm-tags");
  var hpmLinks  = document.getElementById("hpm-links");
  var hpmImage  = document.getElementById("hpm-image");

  function openModal(id) {
    var d = itemMap[id]; if (!d) return;
    hpmTitle.textContent = d.title;
    hpmVenue.textContent = d.venue || ""; hpmVenue.style.display = d.venue ? "" : "none";
    hpmDesc.textContent  = d.description;
    hpmImage.src = d.image; hpmImage.alt = d.title;

    hpmMeta.innerHTML = "";
    (d.meta || []).forEach(function (m) {
      var row = document.createElement("div"); row.className = "hpm-meta-row";
      var lbl = document.createElement("span"); lbl.className = "hpm-meta-label"; lbl.textContent = m.label;
      var val = document.createElement("span"); val.className = "hpm-meta-value"; val.textContent = m.value;
      row.appendChild(lbl); row.appendChild(val); hpmMeta.appendChild(row);
    });

    hpmTags.innerHTML = "";
    (d.tags || []).forEach(function (t) {
      var s = document.createElement("span"); s.className = "hpm-tag"; s.textContent = t;
      hpmTags.appendChild(s);
    });

    hpmLinks.innerHTML = "";
    if (d.links && d.links.length) {
      d.links.forEach(function (lnk) {
        var a = document.createElement("a");
        a.href = lnk.href; a.target = "_blank"; a.rel = "noopener noreferrer";
        a.className = "hpm-link"; a.textContent = lnk.label;
        hpmLinks.appendChild(a);
      });
    } else {
      var s2 = document.createElement("span");
      s2.className = "hpm-link hpm-link-muted"; s2.textContent = "Confidential";
      hpmLinks.appendChild(s2);
    }
    modal.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeModal() { modal.classList.remove("open"); document.body.style.overflow = ""; }

  document.querySelectorAll(".home-proj-card").forEach(function (el) {
    el.addEventListener("click", function () { openModal(el.dataset.id); });
  });
  modal.addEventListener("click", function (e) { if (!card.contains(e.target)) closeModal(); });
  closeBtn.addEventListener("click", closeModal);
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && modal.classList.contains("open")) closeModal();
  });
})();
</script>

