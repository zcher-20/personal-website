          <Icon name="mdi:chevron-right" id="toggle-icon-open" class="w-[15px] h-[15px] hidden" />
        </button>
      </div>

      <!-- Profile photo -->
      <div class="sidebar-photo-wrap">
        <img src="/headshot.jpg" alt="Zayneb Cherif" class="sidebar-photo" draggable="false" />
      </div>

      <div class="sidebar-divider"></div>

      <nav class="app-nav">
        {APP_NAV.map((item) => (
          <>
            <a
              href={item.href}
              class={`app-nav-btn${item.href.startsWith("#") ? " section-scroll-link" : ""}`}
              data-target={item.href.startsWith("#") ? item.href.slice(1) : undefined}
            >
              <Icon name={item.icon} class="app-nav-icon" />
              <span class="app-nav-label">{item.label}</span>
            </a>
            {item.label === "Projects" && <div class="nav-divider" />}
