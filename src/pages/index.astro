          col.appendChild(p);
        });
        hpmStack.appendChild(col);
      });
    } else if (d.tags && d.tags.length) {
      var col = document.createElement("div"); col.className = "hpm-cs-col";
      var lbl = document.createElement("span"); lbl.className = "hpm-cs-col-label"; lbl.textContent = "Stack";
      col.appendChild(lbl);
      d.tags.forEach(function (t) {
        var p = document.createElement("p"); p.className = "hpm-cs-col-item"; p.textContent = t;
        col.appendChild(p);
      });
      hpmStack.appendChild(col);
    }

    hpmImages.innerHTML = "";
    if (d.confidential) {
      showPwGate(hpmImages, function () {
        hpmImages.innerHTML = "";
        var imgs2 = d.images && d.images.length ? d.images : [d.image];
        imgs2.forEach(function (src) {
          var img = document.createElement("img");
          img.src = src; img.alt = d.title; img.className = "hpm-cs-image";
