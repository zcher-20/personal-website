---
import Layout from "../layouts/WorkspaceLayout.astro";
import { identity } from "../config";

const BOOKS = [
  {
    id: 0, country: "Japan",
    title: "Norwegian Wood", author: "Haruki Murakami",
    year: "1987", isbn: "9780375704024", color: "#c8b89a", favorite: true,
    spineW: 32, spineH: 226,
    publisher: "Vintage International", format: "Paperback", pages: "293 pages",
    desc: "A nostalgic story of loss and coming-of-age set against Tokyo's 1960s student movement. Toru Watanabe looks back on his youth and the two very different women who shaped it.",
  },
  {
    id: 1, country: "Pakistan",
    title: "Exit West", author: "Mohsin Hamid",
    year: "2017", isbn: "9780735212176", color: "#9eb0be", favorite: true,
    spineW: 28, spineH: 212,
    publisher: "Riverhead Books", format: "Hardcover", pages: "240 pages",
    desc: "In a city teetering on the brink of civil war, two young people fall in love and flee through mysterious doors that transport migrants across the world.",
  },
  {
    id: 2, country: "Afghanistan",
    title: "The Kite Runner", author: "Khaled Hosseini",
    year: "2003", isbn: "9781594631931", color: "#c8a87c", favorite: false,
    spineW: 26, spineH: 230,
    publisher: "Riverhead Books", format: "Paperback", pages: "371 pages",
    desc: "A sweeping story of friendship, betrayal, and redemption spanning decades of Afghanistan's history — from the last days of the monarchy to the Taliban's brutal rise.",
  },
  {
    id: 3, country: "Turkey",
    title: "The Forty Rules of Love", author: "Elif Shafak",
    year: "2009", isbn: "9780143118527", color: "#b89ab8", favorite: false,
    spineW: 24, spineH: 222,
    publisher: "Viking", format: "Paperback", pages: "368 pages",
    desc: "Two love stories intertwined across eight centuries — a modern American marriage falling apart, and the legendary encounter of the poet Rumi and the dervish Shams of Tabriz.",
  },
  {
    id: 4, country: "France",
    title: "No Exit", author: "Jean-Paul Sartre",
    year: "1944", isbn: "9780679725169", color: "#8a9e8a", favorite: true,
    spineW: 22, spineH: 192,
    publisher: "Gallimard", format: "Paperback", pages: "67 pages",
    desc: "Three strangers locked in a single room for eternity. Sartre's existentialist masterwork distilled into one unforgettable line: Hell is other people.",
  },
  {
    id: 5, country: "England",
    title: "A Room of One's Own", author: "Virginia Woolf",
    year: "1929", isbn: "9780156787338", color: "#ccc8ae", favorite: true,
    spineW: 24, spineH: 200,
    publisher: "Hogarth Press", format: "Paperback", pages: "112 pages",
    desc: "Woolf argues that a woman must have financial independence and a private space if she is to write fiction — a landmark essay of feminist literary criticism.",
  },
  {
    id: 6, country: "Russia",
    title: "White Nights", author: "Fyodor Dostoyevsky",
    year: "1848", isbn: "9780140449266", color: "#9eb0c8", favorite: false,
    spineW: 11, spineH: 190,
    publisher: "Penguin Classics", format: "Paperback", pages: "64 pages",
    desc: "A lonely dreamer encounters a young woman on the canals of St. Petersburg during the city's magical white nights. A tender study of longing and fleeting human connection.",
  },
  {
    id: 7, country: "Italy",
    title: "The Lying Life of Adults", author: "Elena Ferrante",
    year: "2019", isbn: "9781609455910", color: "#c4a0a0", favorite: false,
    spineW: 24, spineH: 224,
    publisher: "Europa Editions", format: "Hardcover", pages: "324 pages",
    desc: "Growing up in 1990s Naples, Giovanna discovers a disreputable aunt and begins to question everything — her class, her body, and her family's carefully maintained façade.",
  },
  {
    id: 8, country: "USA",
    title: "Giovanni's Room", author: "James Baldwin",
    year: "1956", isbn: "9780345806567", color: "#aeaaa0", favorite: true,
    spineW: 26, spineH: 206,
    publisher: "Dial Press", format: "Paperback", pages: "159 pages",
    desc: "An American in 1950s Paris falls in love with an Italian bartender. A devastating exploration of desire, shame, and the violence of self-denial that still resonates today.",
  },
  {
    id: 9, country: "Mexico",
    title: "The Alchemist", author: "Paulo Coelho",
    year: "1988", isbn: "9780061339257", color: "#c8bc80", favorite: false,
    spineW: 17, spineH: 212,
    publisher: "HarperCollins", format: "Paperback", pages: "197 pages",
    desc: "A shepherd boy travels from Andalusia to Egypt in search of treasure, discovering that the universe conspires in favor of those who pursue their personal legend.",
  },
  {
    id: 10, country: "Brazil",
    title: "The Hour of the Star", author: "Clarice Lispector",
    year: "1977", isbn: "9780811211765", color: "#a8c0b0", favorite: true,
    spineW: 22, spineH: 196,
    publisher: "New Directions", format: "Paperback", pages: "96 pages",
    desc: "A poor girl from the Northeast lives invisibly in Rio de Janeiro. Lispector's final novel, narrated by a male writer who struggles to tell her story without consuming it.",
  },
  {
    id: 11, country: "Argentina",
    title: "The Invention of Morel", author: "Adolfo Bioy Casares",
    year: "1940", isbn: "9781590170571", color: "#b8b0cc", favorite: true,
    spineW: 24, spineH: 198,
    publisher: "New York Review Books", format: "Paperback", pages: "103 pages",
    desc: "A fugitive on a mysterious island discovers a machine that creates immortal projections of the dead. A founding text of speculative Latin American fiction, precursor to Lost.",
  },
  {
    id: 12, country: "Chile",
    title: "The House of the Spirits", author: "Isabel Allende",
    year: "1982", isbn: "9781501117015", color: "#c8a0b0", favorite: false,
    spineW: 30, spineH: 234,
    publisher: "Plaza & Janés", format: "Paperback", pages: "433 pages",
    desc: "Three generations of the Trueba family navigate love, political turmoil, and magic in an unnamed Latin American country. Allende's sweeping, magical-realist debut.",
  },
  {
    id: 13, country: "Australia",
    title: "The Book Thief", author: "Markus Zusak",
    year: "2005", isbn: "9780375842207", color: "#b0be9e", favorite: false,
    spineW: 34, spineH: 240,
    publisher: "Picador", format: "Paperback", pages: "552 pages",
    desc: "Narrated by Death during World War II Germany, the story of Liesel Meminger, who steals books and shares them with her neighbors while bombs fall on their street.",
  },
];

/* Books shown on the physical spine shelf */
const FAVORITES = [
  { id:"f00", title:"Chess Story",                              author:"Stefan Zweig",          isbn:"9780241337547", cover:"https://books.google.com/books/content?vid=ISBN9781938890031&printsec=frontcover&img=1&zoom=1", spineW:14, spineH:200,
    year:"1942", publisher:"NYRB Classics",        format:"Paperback", pages:"120 pages",
    desc:"Travelers on a ship discover the world chess champion on board and challenge him. A mysterious passenger steps in — and how he gained his extraordinary skill lies at the heart of Zweig's final work." },
  { id:"f04", title:"Walden",                                  author:"Henry David Thoreau",    isbn:"9780691096124", spineW:26, spineH:224,
    year:"1854", publisher:"Princeton UP",         format:"Paperback", pages:"350 pages",
    desc:"Thoreau's account of two years alone in a cabin at Walden Pond — a foundational American text on self-reliance, nature, and the examined life." },
  { id:"f09", title:"Devotions",                              author:"Mary Oliver",            isbn:"9780399563263", spineW:30, spineH:230,
    year:"2017", publisher:"Penguin Press",        format:"Hardcover", pages:"432 pages",
    desc:"A definitive collection spanning more than fifty years of Oliver's poetry — luminous, mindful writing about the natural world and the art of paying attention." },
  { id:"f05", title:"A Room of One's Own",                     author:"Virginia Woolf",         isbn:"9780156787338", spineW:14, spineH:198,
    year:"1929", publisher:"Hogarth Press",        format:"Paperback", pages:"112 pages",
    desc:"Woolf argues that a woman must have financial independence and a private space if she is to write fiction. A landmark essay of feminist literary criticism." },
  { id:"f06", title:"The Miracle of Mindfulness",             author:"Thich Nhat Hanh",        isbn:"9780807012390", spineW:16, spineH:200,
    year:"1975", publisher:"Beacon Press",         format:"Paperback", pages:"140 pages",
    desc:"A gentle, eloquent introduction to the practice of meditation and mindfulness, cherished by generations of readers for its clarity and quiet wisdom." },
  { id:"f08", title:"Civilization and Its Discontents",       author:"Sigmund Freud",          isbn:"9780393304510", spineW:16, spineH:200,
    year:"1930", publisher:"W. W. Norton",         format:"Paperback", pages:"145 pages",
    desc:"Freud examines why civilization causes suffering on such a vast scale and whether human drives for pleasure and aggression can ever be reconciled." },
  { id:"f10", title:"Never Let Me Go",                        author:"Kazuo Ishiguro",         isbn:"1400043395",    spineW:24, spineH:226,
    year:"2005", publisher:"Vintage",              format:"Paperback", pages:"288 pages",
    desc:"Students at Hailsham boarding school slowly learn the disturbing truth of their existence. A quietly devastating meditation on memory, love, and mortality." },
  { id:"f14", title:"East of Eden",                           author:"John Steinbeck",         isbn:"0142004235",    spineW:38, spineH:240,
    year:"1952", publisher:"Penguin Books",        format:"Paperback", pages:"601 pages",
    desc:"Two families in California's Salinas Valley helplessly reenact the fall of Adam and Eve across generations. Steinbeck called it his magnum opus." },
  { id:"f19", title:"Beloved",                                author:"Toni Morrison",          isbn:"9781400033416", spineW:24, spineH:222,
    year:"1987", publisher:"Knopf",                format:"Paperback", pages:"324 pages",
    desc:"Sethe escaped slavery to Ohio but is still haunted — literally — by a ghost. Morrison's unflinching look into the abyss of slavery, winner of the Pulitzer Prize." },
{ id:"f22", title:"The Devil Finds Work",                   author:"James Baldwin",          isbn:"9780385334112", cover:"https://books.google.com/books/content?vid=ISBN9780385334112&printsec=frontcover&img=1&zoom=1", spineW:16, spineH:204,
    year:"1976", publisher:"Dial Press",           format:"Paperback", pages:"160 pages",
    desc:"Baldwin's book-length essay on racism in American cinema — our loves, hates, and fears reflected in film, from In the Heat of the Night to The Exorcist." },
  { id:"f28", title:"A Breath of Life",                       author:"Clarice Lispector",      isbn:"9780811221207", cover:"https://books.google.com/books/content?vid=ISBN9780811221207&printsec=frontcover&img=1&zoom=1", spineW:18, spineH:210,
    year:"1978", publisher:"New Directions",       format:"Paperback", pages:"200 pages",
    desc:"A posthumous mystical dialogue between a god-like author and his creation, Angela — if Angela dies, Clarice must die too. Assembled from fragments after her death in 1977." },
  { id:"f29", title:"Giovanni's Room",                        author:"James Baldwin",          isbn:"9780345806567", spineW:18, spineH:206,
    year:"1956", publisher:"Dial Press",           format:"Paperback", pages:"159 pages",
    desc:"An American in 1950s Paris falls in love with an Italian bartender. A devastating exploration of desire, shame, and the violence of self-denial that still resonates today." },
  { id:"f30", title:"The Crucible",                           author:"Arthur Miller",          isbn:"9780142437056", spineW:16, spineH:202,
    year:"1953", publisher:"Penguin Books",        format:"Paperback", pages:"152 pages",
    desc:"Salem, 1692: a vengeful teenager's accusation of witchcraft multiplies to consume an entire village. Miller's masterpiece on mass hysteria, written in the shadow of McCarthyism." },
  { id:"f31", title:"No Exit",                                author:"Jean-Paul Sartre",       isbn:"9780679725169", spineW:12, spineH:192,
    year:"1944", publisher:"Gallimard",            format:"Paperback", pages:"67 pages",
    desc:"Three strangers locked in a room for eternity. Sartre's existentialist masterwork distilled into one unforgettable line: Hell is other people." },
  { id:"f32", title:"The Invention of Morel",                 author:"Adolfo Bioy Casares",    isbn:"9781590170571", spineW:14, spineH:196,
    year:"1940", publisher:"NYRB Classics",        format:"Paperback", pages:"103 pages",
    desc:"A fugitive on a mysterious island discovers a machine that creates immortal projections of the dead. Borges called it a masterpiece of plotting — the model for Last Year at Marienbad." },
  { id:"f33", title:"Norwegian Wood",                         author:"Haruki Murakami",        isbn:"9780375704024", spineW:22, spineH:220,
    year:"1987", publisher:"Vintage International", format:"Paperback", pages:"293 pages",
    desc:"A young college student in Tokyo is devoted to a beautiful, introspective woman whose grief pulls her further away. A nostalgic elegy for youth and lost love." },
  { id:"f35", title:"Circe",                                  author:"Madeline Miller",        isbn:"9780316556347", spineW:28, spineH:228,
    year:"2018", publisher:"Little, Brown",        format:"Hardcover", pages:"393 pages",
    desc:"The witch of The Odyssey gets her own story: born powerless among the Titans, Circe discovers her gifts, defies the gods, and forges her identity alone on a deserted island." },
  { id:"f36", title:"Barn Burning",                           author:"Haruki Murakami",        isbn:"9780679750536", spineW:24, spineH:222,
    year:"1993", publisher:"Vintage",              format:"Paperback", pages:"336 pages",
    desc:"A collection of short stories marked by Murakami's signature blend of the everyday and the uncanny — loneliness, jazz, women, cats, and the strange doorways between worlds." },
  { id:"f37", title:"101 Essays That Will Change the Way You Think", author:"Brianna Wiest",  isbn:"9781945796371", spineW:28, spineH:228,
    year:"2018", publisher:"Thought Catalog",      format:"Paperback", pages:"400 pages",
    desc:"Essays on why you should pursue purpose over passion, embrace negative thinking, and become aware of the cognitive biases quietly shaping your life." },
  { id:"f38", title:"The Bell Jar",                           author:"Sylvia Plath",           isbn:"9780061148514", spineW:20, spineH:216,
    year:"1963", publisher:"Harper Perennial",     format:"Paperback", pages:"244 pages",
    desc:"Esther Greenwood, bright and ambitious, unravels under the pressure of 1950s American womanhood. Plath's masterwork of psychological fiction — raw, funny, and unflinching." },
  { id:"f40", title:"The Hunger Games",                       author:"Suzanne Collins",        isbn:"9780439023481", spineW:26, spineH:226,
    year:"2008", publisher:"Scholastic",           format:"Paperback", pages:"374 pages",
    desc:"In a dystopian future, sixteen-year-old Katniss volunteers for the annual televised death match to save her sister — and becomes the spark of a revolution." },
  { id:"f44", title:"Fahrenheit 451",                         author:"Ray Bradbury",           isbn:"9781451673319", spineW:20, spineH:216,
    year:"1953", publisher:"Simon & Schuster",     format:"Paperback", pages:"256 pages",
    desc:"In a future America where books are burned, fireman Guy Montag starts to question the society he serves. Bradbury's incendiary classic of censorship and rebellion." },
  { id:"f45", title:"Fences",                                 author:"August Wilson",          isbn:"9780452264014", spineW:14, spineH:196,
    year:"1985", publisher:"Plume",                format:"Paperback", pages:"101 pages",
    desc:"Troy Maxson, a proud and difficult Black man in 1950s Pittsburgh, struggles with his own fences — the ones he builds and the ones built around him. Wilson's Pulitzer-winning play." },
  { id:"f46", title:"Flowers for Algernon",                   author:"Daniel Keyes",           isbn:"9780156030304", spineW:24, spineH:222,
    year:"1966", publisher:"Harcourt",             format:"Paperback", pages:"311 pages",
    desc:"Charlie Gordon has an unusually low IQ and is chosen for an experimental surgery that makes him a genius — until the lab mouse Algernon begins to deteriorate." },
  { id:"f49", title:"The Song of Achilles",                   author:"Madeline Miller",        isbn:"9780062060624", spineW:26, spineH:226,
    year:"2011", publisher:"Ecco",                 format:"Paperback", pages:"378 pages",
    desc:"A dazzling retelling of the Iliad through the eyes of Patroclus — his love for Achilles, the brutality of Troy, and the cost of immortal glory." },
  { id:"f50", title:"The Catcher in the Rye",                 author:"J. D. Salinger",         isbn:"9780316769174", spineW:22, spineH:220,
    year:"1951", publisher:"Little, Brown",        format:"Paperback", pages:"277 pages",
    desc:"Holden Caulfield, expelled from prep school, drifts through New York for three days — searching for something genuine in a world that feels insincere and superficial." },
  { id:"f52", title:"The Great Gatsby",                       author:"F. Scott Fitzgerald",    isbn:"9780743273565", spineW:18, spineH:208,
    year:"1925", publisher:"Scribner",             format:"Paperback", pages:"180 pages",
    desc:"Nick Carraway moves to Long Island and is drawn into the orbit of the wealthy, mysterious Jay Gatsby — a Jazz Age examination of the American Dream and its corruption." },
  { id:"f54", title:"One Flew Over the Cuckoo's Nest",        author:"Ken Kesey",              isbn:"9780143056980", cover:"https://books.google.com/books/content?vid=ISBN9780451163968&printsec=frontcover&img=1&zoom=1", spineW:24, spineH:222,
    year:"1962", publisher:"Viking Press",         format:"Paperback", pages:"320 pages",
    desc:"Randle McMurphy brings chaos and life to a psychiatric ward ruled by the iron will of Nurse Ratched. Kesey's classic of rebellion against conformity and institutional power." },
];

const PANEL_W = 340;
const SPINE_W = 16;
const FAVORITES_DISPLAY = FAVORITES.map(b => ({ ...b, spineW: SPINE_W }));
---

<Layout
  seo={{
    title: "Bookshelf | " + identity.name,
    description: "One book per country — reading the world.",
    image: identity.logo,
  }}
>
  <script id="books-data" type="application/json" set:html={JSON.stringify(BOOKS)} />
  <div id="tooltip" class="books-tooltip"></div>

  <div class="bs-page">

    <!-- ══ HERO ══ -->
    <div class="bs-header">
      <hr class="bs-rule" />
      <div class="bs-header-row">
        <h1 class="bs-title">Bookshelf</h1>
      </div>
      <hr class="bs-rule" />
    </div>

    <!-- ══ SHELF (favourites) ══ -->
    <div class="shelf-area">
      <div class="shelf" id="shelf">
        {FAVORITES_DISPLAY.map((b) => (
          <div
            class="book"
            data-id={b.id}
            data-sw={String(b.spineW)}
            style={`width:${b.spineW}px; --sh:${b.spineH}px`}
            title={b.title}
          >
            <!-- ── Spine (closed state) ── -->
            <div class="spine" style={`width:${b.spineW}px;height:${b.spineH}px;`}>
              <img
                class="spine-img"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                data-src={b.cover || `https://covers.openlibrary.org/b/isbn/${b.isbn}-M.jpg`}
                alt={b.title}
              />
            </div>

            <!-- ── Panel (open state) ── -->
            <div class="book-panel">
              <div class="b-cover">
                <img
                  src={b.cover || `https://covers.openlibrary.org/b/isbn/${b.isbn}-M.jpg`}
                  alt={b.title}
                  onerror="this.style.opacity='0'"
                  loading="lazy"
                />
              </div>
              <div class="b-info">
                <h2 class="bi-title">{b.title}</h2>
                <p class="bi-desc">{b.desc}</p>
                <div class="bi-meta">
                  <div class="meta-row">
                    <span class="ml">PUBLISHED</span>
                    <span class="mv">{b.year}</span>
                  </div>
                  <div class="meta-row">
                    <span class="ml">PUBLISHER</span>
                    <span class="mv">{b.publisher}</span>
                  </div>
                  <div class="meta-row">
                    <span class="ml">FORMAT</span>
                    <span class="mv">{b.format}</span>
                  </div>
                  <div class="meta-row">
                    <span class="ml">PAGES</span>
                    <span class="mv">{b.pages}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <hr class="bs-shelf-divider" />

    <!-- ══ MAP + READING LIST ══ -->
    <div class="bs-lower">
      <div class="bs-map-col">
        <h2 class="bs-list-title">Reading the World</h2>
        <section id="map-container" class="bs-map"></section>
        <p class="bs-list-sub">Tracking my progress as I read a book from every country in the world!</p>
      </div>
      <div class="bs-list-col">
        <ul class="bs-list">
          {BOOKS.map((b) => (
            <li class="bs-li">
              <span class="bl-country">{b.country}</span>
              <span class="bl-sep">—</span>
              <span class="bl-title">{b.title}</span>
              <span class="bl-author">{b.author}{b.favorite ? " *" : ""}</span>
            </li>
          ))}
        </ul>
        <p class="bs-footnote">* personal favourite</p>
      </div>
    </div>

    <div style="height:80px;"></div>
  </div>
</Layout>

<!-- ══ GLOBAL (for tooltip + map SVG) ══ -->
<style is:global>
  .books-tooltip {
    display: none; position: fixed; font-size: 11px;
    background: #fff; color: #000; padding: 8px 12px;
    pointer-events: none; z-index: 100; line-height: 1.5;
    border: 1px solid #e8e8e8;
  }
  .bs-map svg { display: block; width: 100%; height: auto; }
</style>

<style>
  /* ── Page ── */
  .bs-page {
    font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    background: #fff;
  }

  /* ── Hero ── */
  .bs-header {
    padding: 52px 52px 0;
  }
  .bs-rule {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 0;
  }
  .bs-header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 18px 0;
  }
  .bs-title {
    font-size: 28px;
    font-weight: 300;
    color: #1d1d1f;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  /* ── Shelf area: vertically centers the shelf with lots of white space ── */
  .shelf-area {
    display: flex;
    align-items: center;
    min-height: 44vh;
    overflow-x: auto;
    overflow-y: visible;
    padding: 90px 0 120px;
    scrollbar-width: thin;
    scrollbar-color: #d8d8d8 transparent;
  }
  .shelf-area::-webkit-scrollbar { height: 3px; }
  .shelf-area::-webkit-scrollbar-track { background: transparent; }
  .shelf-area::-webkit-scrollbar-thumb { background: #d8d8d8; border-radius: 2px; }

  .shelf {
    display: flex;
    align-items: flex-end;      /* books share a common baseline */
    padding: 0 52px;
    gap: 2px;
    flex-shrink: 0;
    zoom: 1.25;
  }

  /* ── Book wrapper ── */
  .book {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    flex-shrink: 0;
    cursor: pointer;
    /* width transitions from spineW → PANEL_W */
    transition: width 430ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ── Spine ── */
  .spine {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    transition:
      width 430ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity 200ms ease;
  }

  .book.selected .spine {
    width: 0 !important;
    opacity: 0;
    pointer-events: none;
  }

  .spine-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .book.selected .spine-img {
    filter: none;
  }

  /* ── Expanded panel (cover + info) ── */
  .book-panel {
    display: flex;
    align-items: flex-end;
    flex-shrink: 0;
    width: 340px;
    height: var(--sh, 192px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms 180ms ease;
  }

  .book.selected .book-panel {
    opacity: 1;
    pointer-events: auto;
  }

  /* Cover */
  .b-cover {
    height: var(--sh, 192px);
    flex-shrink: 0;
    align-self: flex-end;
  }
  .b-cover img {
    height: 100%;
    width: auto;
    display: block;
  }

  /* Info panel */
  .b-info {
    flex: 1;
    padding: 0 12px 0 14px;
    align-self: flex-start;
    min-width: 0;
    overflow: hidden;
  }

  .bi-title {
    font-size: 12px;
    font-weight: 500;
    color: #111;
    margin: 0 0 7px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .bi-desc {
    font-size: 9px;
    color: #888;
