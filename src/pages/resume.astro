---
import Layout from "../layouts/WorkspaceLayout.astro";

const seo = { title: "Resume — Zayneb Cherif", description: "Resume of Zayneb Cherif.", image: "/headshot.jpg" };
---

<Layout seo={seo}>
  <div class="resume-page">
    <div class="resume-inner">
      <div class="resume-header">
        <h1 class="resume-title">Resume</h1>
        <a href="/Zayneb_Cherif_Resume.pdf" download class="resume-download-btn">
          Download PDF ↓
        </a>
      </div>
      <div class="resume-preview-wrap">
        <iframe
          src="/Zayneb_Cherif_Resume.pdf"
          class="resume-iframe"
          title="Zayneb Cherif Resume"
        ></iframe>
      </div>
    </div>
  </div>
</Layout>

<style>
  .resume-page {
    padding-bottom: 80px;
  }
  .resume-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 72px 40px 0;
  }
  .resume-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 40px;
  }
  .resume-title {
    font-size: 28px;
    font-weight: 300;
    color: #1d1d1f;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }
  .resume-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border: 1px solid #e8e8e8;
    border-radius: 100px;
    background: #fff;
    color: #1d1d1f;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
    margin-bottom: -4px;
  }
  .resume-download-btn:hover {
    border-color: #ccc;
    color: #1d1d1f;
  }
  .resume-preview-wrap {
    width: 100%;
    border: 1px solid #efefef;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .resume-iframe {
    width: 100%;
    height: 80vh;
    border: none;
    display: block;
  }

  @media (max-width: 768px) {
    .resume-inner { padding: 32px 20px 0; }
    .resume-iframe { height: 70vh; }
  }
</style>
