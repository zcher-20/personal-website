---
import Layout from "../layouts/WorkspaceLayout.astro";
import { identity } from "../config";
---

<Layout
  seo={{
    title: "Photography | " + identity.name,
    description: "Photography by Zayneb Cherif.",
    image: identity.logo,
  }}
>
  <!-- ── Video hero ── -->
  <div class="video-hero">
    <video class="video-bg" autoplay muted loop playsinline>
      <source src="/photography-header.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- ── Gallery marquees ── -->
  <section class="marquee-section scroll-reveal">
    <p class="marquee-label">Morocco</p>
    <div class="marquee-outer">
      <div class="fade-left"></div><div class="fade-right"></div>
      <div id="gallery-track" class="marquee-track"></div>
    </div>
  </section>

  <section class="marquee-section scroll-reveal">
    <p class="marquee-label">Spain</p>
    <div class="marquee-outer">
      <div class="fade-left"></div><div class="fade-right"></div>
      <div id="spain-track" class="marquee-track"></div>
    </div>
  </section>

  <section class="marquee-section scroll-reveal">
    <p class="marquee-label">Switzerland</p>
    <div class="marquee-outer">
      <div class="fade-left"></div><div class="fade-right"></div>
      <div id="switzerland-track" class="marquee-track"></div>
    </div>
  </section>

  <div style="height:80px;"></div>
</Layout>

<style>
  /* ── Video hero ── */
  .video-hero {
    position: relative;
    width: 100%;
    height: 72vh;
    min-height: 480px;
    overflow: hidden;
    background: #000;
  }
  .video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 88% 65%;
  }
  .video-title-wrap {
    position: absolute;
    bottom: 28px;
    left: 36px;
    pointer-events: none;
    z-index: 10;
    white-space: nowrap;
  }
  .video-title {
    font-size: 32px;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #2a2a2a;
    margin: 0;
    line-height: 1;
  }

  /* ── Marquees ── */
  .marquee-section { margin-top: 56px; }
  .marquee-label {
    font-size: 22px; font-weight: 300; letter-spacing: -0.01em;
    color: #2a2a2a; margin: 0 0 14px; text-align: center;
  }
  .marquee-outer { position: relative; overflow-x: auto; overflow-y: hidden; width: 100%; scrollbar-width: none; }
  .marquee-outer::-webkit-scrollbar { display: none; }
  .fade-left  { position:absolute;left:0;top:0;bottom:0;width:60px;background:linear-gradient(to right,white,transparent);z-index:2;pointer-events:none; }
  .fade-right { position:absolute;right:0;top:0;bottom:0;width:60px;background:linear-gradient(to left,white,transparent);z-index:2;pointer-events:none; }
  .marquee-track { display:flex;gap:12px;width:max-content;padding:8px 32px 16px; }

  @media (max-width: 768px) {
    .video-hero   { height: 50vh; min-height: 280px; }
    .video-title  { font-size: 24px; }
    .video-title-wrap { bottom: 20px; left: 20px; }
    .marquee-section  { margin-top: 36px; }
    .marquee-label    { font-size: 18px; }
  }
</style>

<script is:inline>
  function buildGallery(trackId, srcs) {
    var track = document.getElementById(trackId);
    if (!track) return;
    track.innerHTML = "";
    srcs.forEach(function (src) {
      var item = document.createElement("div");
      item.style.cssText = "flex-shrink:0;width:200px;height:140px;overflow:hidden;border-radius:4px;";
      var img = document.createElement("img");
      img.src = src; img.loading = "lazy"; img.decoding = "async";
      img.style.cssText = "width:100%;height:100%;object-fit:cover;image-orientation:from-image;";
      item.appendChild(img);
      track.appendChild(item);
    });

    /* Drag-to-scroll (pointer events: works on mouse + touch) */
    var outer = track.parentElement;
    outer.style.cursor = "grab";
    outer.style.touchAction = "pan-y";
    var dragging = false, startX = 0, scrollLeft = 0;
    outer.addEventListener("pointerdown", function (e) {
      dragging = true;
      outer.style.cursor = "grabbing";
      outer.setPointerCapture(e.pointerId);
      startX = e.clientX;
      scrollLeft = outer.scrollLeft;
    });
    outer.addEventListener("pointerup",     function () { dragging = false; outer.style.cursor = "grab"; });
    outer.addEventListener("pointercancel", function () { dragging = false; outer.style.cursor = "grab"; });
    outer.addEventListener("pointermove",   function (e) {
      if (!dragging) return;
      e.preventDefault();
      outer.scrollLeft = scrollLeft - (e.clientX - startX);
    });
  }

  function initGalleries() {
    buildGallery("gallery-track", [
      "/photography/thumbs/morocco--98586D38-38FC-4F70-BCAF-1A20B19D7947.webp",
      "/photography/thumbs/morocco--IMG_3049.webp",
      "/photography/thumbs/morocco--IMG_7172.webp",
      "/photography/thumbs/morocco--IMG_8971.webp",
      "/photography/thumbs/morocco--IMG_9150.webp",
      "/photography/thumbs/morocco--IMG_9172.webp",
      "/photography/thumbs/morocco--IMG_9295.webp",
      "/photography/thumbs/morocco--IMG_9553.webp",
      "/photography/thumbs/morocco--Tezza-5653.webp",
    ]);

    buildGallery("spain-track", [
      "/photography/thumbs/spain--IMG_1036.webp",
      "/photography/thumbs/spain--IMG_1065.webp",
      "/photography/thumbs/spain--IMG_3242.webp",
      "/photography/thumbs/spain--IMG_5296.webp",
      "/photography/thumbs/spain--IMG_5336.webp",
      "/photography/thumbs/spain--IMG_5660.webp",
      "/photography/thumbs/spain--IMG_6780.webp",
      "/photography/thumbs/spain--IMG_6797.webp",
    ]);

    buildGallery("switzerland-track", [
      "/photography/thumbs/switzerland--A9CAAB5F-644C-4EA6-96E6-193BB256629B.webp",
      "/photography/thumbs/switzerland--IMG_0403.webp",
      "/photography/thumbs/switzerland--IMG_0435.webp",
      "/photography/thumbs/switzerland--IMG_0913.webp",
      "/photography/thumbs/switzerland--IMG_1154.webp",
      "/photography/thumbs/switzerland--IMG_1414.webp",
      "/photography/thumbs/switzerland--IMG_1551.webp",
      "/photography/thumbs/switzerland--IMG_1661.webp",
      "/photography/thumbs/switzerland--IMG_1857.webp",
      "/photography/thumbs/switzerland--IMG_2243.webp",
      "/photography/thumbs/switzerland--IMG_2261.webp",
      "/photography/thumbs/switzerland--IMG_2707.webp",
      "/photography/thumbs/switzerland--IMG_9831.webp",
    ]);
  }

  document.addEventListener("astro:page-load", initGalleries);
</script>
