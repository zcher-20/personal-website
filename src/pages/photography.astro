      "/photography/thumbs/morocco--IMG_3049.webp",
      "/photography/thumbs/morocco--IMG_7172.webp",
      "/photography/thumbs/morocco--IMG_8971.webp",
      "/photography/thumbs/morocco--IMG_9150.webp",
      "/photography/thumbs/morocco--IMG_9172.webp",
      "/photography/thumbs/morocco--IMG_9295.webp",
      "/photography/thumbs/morocco--IMG_9553.webp",
      "/photography/thumbs/morocco--Tezza-5653.webp",
    ],
  },
  {
    id: "spain",
    name: "Spain",
    images: [
      "/photography/thumbs/spain--IMG_1036.webp",
      "/photography/thumbs/spain--IMG_1065.webp",
      "/photography/thumbs/spain--IMG_3242.webp",
      "/photography/thumbs/spain--IMG_5296.webp",
      "/photography/thumbs/spain--IMG_5336.webp",
      "/photography/thumbs/spain--IMG_5660.webp",
      "/photography/thumbs/spain--IMG_6780.webp",
      "/photography/thumbs/spain--IMG_6797.webp",
    ],
  },
  {
    id: "switzerland",
    name: "Switzerland",
    images: [
      "/photography/thumbs/switzerland--A9CAAB5F-644C-4EA6-96E6-193BB256629B.webp",
      "/photography/thumbs/switzerland--IMG_0403.webp",
      "/photography/thumbs/switzerland--IMG_0435.webp",
      "/photography/thumbs/switzerland--IMG_0913.webp",
      "/photography/thumbs/switzerland--IMG_1154.webp",
      "/photography/thumbs/switzerland--IMG_1414.webp",
      "/photography/thumbs/switzerland--IMG_1551.webp",
      "/photography/thumbs/switzerland--IMG_1661.webp",
      "/photography/thumbs/switzerland--IMG_1857.webp",
      "/photography/thumbs/switzerland--IMG_2243.webp",
      "/photography/thumbs/switzerland--IMG_2261.webp",
      "/photography/thumbs/switzerland--IMG_2707.webp",
      "/photography/thumbs/switzerland--IMG_9831.webp",
    ],
  },
  {
    id: "trail",
    name: "Trail",
    images: [
      "/photography/thumbs/trail--100_1775.webp",
      "/photography/thumbs/trail--IMG_0005.webp",
      "/photography/thumbs/trail--IMG_0064.webp",
      "/photography/thumbs/trail--IMG_0145.webp",
      "/photography/thumbs/trail--IMG_0667.webp",
      "/photography/thumbs/trail--IMG_0840.webp",
      "/photography/thumbs/trail--IMG_0858.webp",
      "/photography/thumbs/trail--IMG_1176.webp",
      "/photography/thumbs/trail--IMG_2675.webp",
      "/photography/thumbs/trail--IMG_3857.webp",
      "/photography/thumbs/trail--IMG_6484.webp",
      "/photography/thumbs/trail--IMG_6875.webp",
      "/photography/thumbs/trail--IMG_8531.webp",
      "/photography/thumbs/trail--IMG_9023.webp",
      "/photography/thumbs/trail--IMG_9108.webp",
      "/photography/thumbs/trail--IMG_9553.webp",
      "/photography/thumbs/trail--IMG_9863.webp",
      "/photography/thumbs/trail--Tezza-5653.webp",
    ],
  },
];
---

<Layout
  seo={{
    title: "Photography | " + identity.name,
    description: "Photography by Zayneb Cherif.",
    image: identity.logo,
  }}
>

  <!-- ── Category landing ── -->
  <div id="photo-landing" class="photo-landing">

    <div class="cat-grid">
      {COUNTRIES.map((country) => (
        <div class="cat-card" data-id={country.id} tabindex="0" role="button" aria-label={country.name}>
          <div class="cat-stack">
            <div class="card-back">
              <img src={country.images[1] ?? country.images[0]} alt="" loading="lazy" />
            </div>
            <div class="card-front">
              <img src={country.images[0]} alt={country.name} loading="eager" />
            </div>
          </div>
          <p class="cat-name">{country.name}</p>
        </div>
      ))}
    </div>

    <div class="photo-center-label">Photography</div>

  </div>

  <!-- ── Detail views (one per country) ── -->
  {COUNTRIES.map((country) => (
    <div id={`detail-${country.id}`} class="photo-detail" aria-hidden="true">
      <div class="detail-header">
        <button class="back-btn" data-back>
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <h2 class="detail-title">{country.name}</h2>
      </div>
      <div class="detail-grid">
        {country.images.map((src) => (
          <div class="detail-img-wrap" data-src={src}>
            <img src={src} alt="" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- ── Lightbox ── -->
  <div id="photo-lightbox" class="photo-lightbox" aria-hidden="true">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close">&#x2715;</button>
    <img id="lightbox-img" src="" alt="" />
  </div>

</Layout>

<script is:inline>
(function () {
  var landing   = document.getElementById("photo-landing");
  var lightbox  = document.getElementById("photo-lightbox");
  var lbImg     = document.getElementById("lightbox-img");
  var lbClose   = document.getElementById("lightbox-close");
  var activeDetail = null;

  function showDetail(id) {
    landing.classList.add("hidden");
    var detail = document.getElementById("detail-" + id);
    if (!detail) return;
    detail.classList.add("active");
    detail.setAttribute("aria-hidden", "false");
    activeDetail = detail;
    window.scrollTo(0, 0);
  }

  function showLanding() {
    if (activeDetail) {
      activeDetail.classList.remove("active");
      activeDetail.setAttribute("aria-hidden", "true");
      activeDetail = null;
    }
    landing.classList.remove("hidden");
  }

  function openLightbox(src) {
    lbImg.src = src;
    lightbox.classList.add("open");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.remove("open");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lbImg.src = "";
  }

  // Category card clicks
  document.querySelectorAll(".cat-card").forEach(function (card) {
    card.addEventListener("click", function () { showDetail(card.dataset.id); });
    card.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); showDetail(card.dataset.id); }
    });
  });

  // Back buttons
  document.querySelectorAll(".back-btn[data-back]").forEach(function (btn) {
    btn.addEventListener("click", showLanding);
  });

  // Detail image clicks → lightbox
  document.querySelectorAll(".detail-img-wrap").forEach(function (wrap) {
    wrap.addEventListener("click", function () { openLightbox(wrap.dataset.src); });
  });

  // Lightbox close
  lbClose.addEventListener("click", closeLightbox);
  lightbox.addEventListener("click", function (e) {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && lightbox.classList.contains("open")) closeLightbox();
  });
})();
</script>

<style>
  @font-face {
    font-family: "Bastliga One";
    src: url("/fonts/BastligaOne.otf") format("opentype");
    font-display: block;
  }

  /* ── Landing ── */
  .photo-landing {
    padding: 72px 48px 80px;
    min-height: 100%;
  }
  .photo-landing.hidden { display: none; }

  /* ── Category grid ── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px 24px;
    max-width: 900px;
    margin: 0 auto;
    justify-items: center;
  }

  /* ── Center label ── */
  .photo-center-label {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a0a0a0;
    margin: 52px 0 0;
    text-align: center;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    cursor: pointer;
    outline: none;
  }

  /* Stacked card */
  .cat-stack {
    position: relative;
    width: 130px;
    height: 168px;
    margin-bottom: 20px;
  }

  .card-front,
  .card-back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.14);
  }

  .card-front img,
  .card-back img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .card-front {
    transform: rotate(2deg);
    z-index: 1;
    transition: transform 0.4s ease;
  }

  .card-back {
    transform: rotate(90deg) scale(0.5);
    opacity: 0;
    z-index: 2;
    transition: transform 0.45s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.3s ease;
  }

  .cat-card:hover .card-back {
    transform: rotate(1deg) scale(1);
    opacity: 1;
  }

  .cat-card:hover .card-front {
    transform: rotate(2.5deg);
  }

  .cat-name {
    font-family: "Bastliga One", cursive;
    font-size: 26px;
    font-weight: 400;
    color: #1d1d1f;
    margin: 0 0 8px;
    text-align: center;
    line-height: 1.2;
  }


  /* ── Detail view ── */
  .photo-detail {
    display: none;
    padding: 40px 48px 100px;
    min-height: 100%;
  }
  .photo-detail.active { display: block; }

  .detail-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 40px;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 20px;
  }

  .back-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 12px;
    color: #8a8a8a;
    padding: 0;
    transition: color 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .back-btn:hover { color: #1d1d1f; }

  .detail-title {
    font-family: "Bastliga One", cursive;
    font-size: 28px;
    font-weight: 400;
    color: #1d1d1f;
    margin: 0;
  }

  .detail-grid {
    columns: 4;
    column-gap: 12px;
  }

  .detail-img-wrap {
    break-inside: avoid;
    margin-bottom: 12px;
    cursor: zoom-in;
    overflow: hidden;
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .detail-img-wrap:hover {
    transform: rotate(-0.8deg) scale(1.02);
    box-shadow: 0 8px 28px rgba(0,0,0,0.14);
    z-index: 2;
    position: relative;
  }

  .detail-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* ── Lightbox ── */
  .photo-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0,0,0,0.78);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .photo-lightbox.open { display: flex; }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    font-size: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
    z-index: 2;
  }
  .lightbox-close:hover { background: rgba(255,255,255,0.2); }

  #lightbox-img {
    max-width: 88vw;
    max-height: 88vh;
    object-fit: contain;
    display: block;
    box-shadow: 0 24px 80px rgba(0,0,0,0.5);
    cursor: default;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .photo-landing { padding: 40px 20px 60px; }
    .cat-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 16px; }
    .cat-stack { width: 110px; height: 142px; }
    .cat-name { font-size: 16px; }
    .photo-center-label { margin: 36px 0 0; }
    .photo-detail { padding: 28px 20px 80px; }
    .detail-grid { columns: 2; column-gap: 8px; }
    .detail-img-wrap { margin-bottom: 8px; }
    .detail-title { font-size: 20px; }
  }
</style>
