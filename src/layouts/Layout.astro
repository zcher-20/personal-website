---
import { Icon } from "astro-icon/components";
import { ViewTransitions } from "astro:transitions";
import { navBarLinks, identity } from "../config";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
  canvasPage?: boolean;
  noNav?: boolean;
}

const { seo, canvasPage = false, noNav = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageURL = seo.image?.startsWith("http")
  ? seo.image
  : new URL(seo.image || "/logo.webp", Astro.site).toString();
const path = Astro.url.pathname;
const isActive = (url: string) =>
  url === "/" ? path === "/" : path === url || path.startsWith(url + "/");
---

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((btn) => {
      btn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    });

    const menuBtn = document.getElementById("mobile-menu-btn");
    const openInd = document.getElementById("mobile-open-ind");
    const drawer = document.getElementById("mobile-nav-drawer");
    if (menuBtn && drawer && openInd) {
      menuBtn.addEventListener("click", () => {
        const isOpen = !drawer.classList.contains("hidden");
        drawer.classList.toggle("hidden");
        openInd.textContent = isOpen ? "+" : "−";
      });
      document.addEventListener("click", (e) => {
        if (!menuBtn.contains(e.target as Node) && !drawer.contains(e.target as Node)) {
          drawer.classList.add("hidden");
          openInd.textContent = "+";
        }
      });
    }

    const nav = document.getElementById("site-nav");
    if (nav) {
      document.documentElement.style.setProperty("--nav-h", nav.offsetHeight + "px");
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll(".scroll-reveal").forEach((el) => observer.observe(el));
  });
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" />
    {canvasPage && <link rel="preload" href="/headshot.jpg" as="image" />}
    <slot name="head" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:site_name" content="Zayneb Cherif" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={fullImageURL} />

    <link rel="alternate" type="application/rss+xml" title="Zayneb Cherif's Blog" href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Zayneb Cherif",
      "url": Astro.site,
      "author": { "@type": "Person", "name": "Zayneb Cherif", "email": "zc2913@columbia.edu" }
    })} />

    <script is:inline>
      const theme = localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
    <ViewTransitions />
  </head>

  <body class="bg-white dark:bg-[#0c0c0c] text-black dark:text-white transition-colors flex flex-col min-h-screen">

    <!-- Custom cursor (mouse devices only) — persisted across View Transitions -->
    <div id="cursor-dot" transition:persist></div>
    <div id="cursor-ring" transition:persist></div>

    <!-- Desktop nav -->
    <header id="site-nav" class={`${noNav ? "!hidden" : ""} hidden md:flex items-center justify-between px-10 py-[14px] border-b border-black/[0.07] dark:border-white/[0.07] sticky top-0 bg-white/90 dark:bg-[#0c0c0c]/90 backdrop-blur-sm z-50`}>
      <div class="flex items-baseline gap-3">
        <a href="/" class="font-bold text-[13px] tracking-[0.14em] uppercase">{identity.name}</a>
        <span class="text-[10.5px] tracking-widest uppercase opacity-35">CS + Design</span>
      </div>

      <nav class="flex items-center gap-7">
        {navBarLinks.map((link) => (
          <a
            href={link.url}
            target={link.external ? "_blank" : "_self"}
            class={`text-[11px] tracking-[0.1em] uppercase transition-colors ${
              isActive(link.url)
                ? "text-[#c4501e] font-semibold"
                : "opacity-40 hover:opacity-85"
            }`}
          >
            {link.title}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-5">
        <a
          href="https://github.com/zcher-20"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[11px] tracking-widest uppercase opacity-35 hover:opacity-70 transition-opacity"
        >
          GitHub ↗
        </a>
        <button id="theme-toggle" class="opacity-35 hover:opacity-70 transition-opacity" aria-label="Toggle theme">
          <Icon name="mdi:weather-sunny" class="w-[15px] h-[15px] hidden dark:block" />
          <Icon name="mdi:weather-night" class="w-[15px] h-[15px] block dark:hidden" />
        </button>
      </div>
    </header>

    <!-- Mobile nav -->
    <header class={`${noNav ? "!hidden" : ""} md:hidden flex items-center justify-between px-5 py-4 border-b border-black/[0.07] dark:border-white/[0.07] sticky top-0 bg-white/90 dark:bg-[#0c0c0c]/90 backdrop-blur-sm z-50`}>
      <a href="/" class="font-bold text-[13px] tracking-[0.14em] uppercase">{identity.name}</a>
      <div class="flex items-center gap-3">
        <button id="theme-toggle-mobile" class="opacity-35 hover:opacity-70 transition-opacity p-1" aria-label="Toggle theme">
          <Icon name="mdi:weather-sunny" class="w-4 h-4 hidden dark:block" />
          <Icon name="mdi:weather-night" class="w-4 h-4 block dark:hidden" />
        </button>
        <button id="mobile-menu-btn" class="text-[11px] tracking-widest uppercase opacity-50 hover:opacity-100 transition-opacity">
          Menu <span id="mobile-open-ind">+</span>
        </button>
      </div>
    </header>
    <div id="mobile-nav-drawer" class="hidden md:hidden border-b border-black/[0.07] dark:border-white/[0.07] px-5 py-5 bg-white dark:bg-[#0c0c0c] z-40">
      <ul class="flex flex-col gap-4">
        {navBarLinks.map((link) => (
          <li>
            <a
              href={link.url}
              target={link.external ? "_blank" : "_self"}
              class={`text-[13px] tracking-widest uppercase transition-colors ${
                isActive(link.url) ? "text-[#c4501e]" : "opacity-45 hover:opacity-100"
              }`}
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Main -->
    <main class={canvasPage ? "flex-1 overflow-hidden flex flex-col" : "flex-1"}>
      <slot />
    </main>

    {!canvasPage && (
      <footer class="border-t border-black/[0.07] dark:border-white/[0.07] px-10 py-6 mt-10">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] uppercase tracking-widest opacity-25">© 2026 Zayneb Cherif</span>
          <span class="text-[10.5px] uppercase tracking-widest opacity-25">zaynebcheriff@gmail.com</span>
        </div>
      </footer>
    )}
  </body>
</html>

<style is:global>
  :root { --mauve: #9e7fa4; }

  html {
    font-family: "Inter", sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  code {
    font-family: Menlo, Monaco, "Courier New", monospace;
  }

  .hover-underline {
    text-decoration: underline 1px rgba(0, 0, 0, 0);
    text-underline-offset: 5px;
    transition: text-decoration-color 300ms;
  }
  .post:hover .hover-underline {
    text-decoration-color: currentColor;
  }

  .mb-14 a, .mb-6 a {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 200ms ease;
  }
  .mb-14 a:hover, .mb-6 a:hover { color: #1d4ed8; }
  .dark .mb-14 a, .dark .mb-6 a { color: #60a5fa; }
  .dark .mb-14 a:hover, .dark .mb-6 a:hover { color: #93c5fd; }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .exp-logo img[src="/bch.webp"],
  .exp-logo img[src="/ibm.webp"] {
    object-fit: contain;
  }

  /* ── Custom cursor (pointer / mouse only) ── */
  @media (pointer: fine) {
    *, *::before, *::after { cursor: none !important; }

    #cursor-dot {
      position: fixed;
      top: -20px; left: -20px;
      width: 5px; height: 5px;
      background: #1d1d1f;
      border-radius: 50%;
      pointer-events: none;
      /* above everything including canvas/mind overflow containers */
      z-index: 2147483647;
      transform: translate(-50%, -50%);
      transition: transform 0.15s ease, opacity 0.15s;
      will-change: transform, left, top;
      opacity: 0;
    }

    #cursor-ring {
      position: fixed;
      top: -20px; left: -20px;
      width: 28px; height: 28px;
      border: 1px solid rgba(29, 29, 31, 0.38);
      border-radius: 50%;
      pointer-events: none;
      z-index: 2147483646;
      transform: translate(-50%, -50%);
      transition: width 0.2s ease, height 0.2s ease,
                  border-color 0.2s, background 0.2s, opacity 0.15s;
      will-change: transform, left, top;
      opacity: 0;
    }

    #cursor-dot.cur-visible  { opacity: 1; }
    #cursor-ring.cur-visible { opacity: 1; }

    #cursor-dot.cur-hover {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
    }
    #cursor-ring.cur-hover {
      width: 40px; height: 40px;
      border-color: rgba(29, 29, 31, 0.55);
      background: rgba(29, 29, 31, 0.035);
    }

    #cursor-dot.cur-click { transform: translate(-50%, -50%) scale(0.4); }
    #cursor-ring.cur-click {
      width: 18px; height: 18px;
      background: rgba(29, 29, 31, 0.07);
    }
  }
</style>

<script is:inline>
(function () {
  if (!window.matchMedia("(pointer: fine)").matches) return;

  var dot  = document.getElementById("cursor-dot");
  var ring = document.getElementById("cursor-ring");
  if (!dot || !ring) return;

  var mx, my, rx, ry, hasMoved = false;

  document.addEventListener("mousemove", function (e) {
    mx = e.clientX; my = e.clientY;
    dot.style.left = mx + "px";
    dot.style.top  = my + "px";
    if (!hasMoved) {
      hasMoved = true;
      rx = mx; ry = my;
      dot.classList.add("cur-visible");
      ring.classList.add("cur-visible");
    }
  }, { passive: true });

  (function animate() {
    if (hasMoved) {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.left = rx + "px";
      ring.style.top  = ry + "px";
    }
    requestAnimationFrame(animate);
  })();

  var HOVER_SEL = "a, button, label, input, select, textarea, " +
    "[role='button'], .item, .home-proj-card, .mobile-proj-item, " +
    ".app-nav-btn, .sidebar-resume-btn, .flyout-item, .mobile-nav-btn, " +
    ".exp-row, .cat-card, .about-projects-wrap";

  document.addEventListener("mouseover", function (e) {
    if (e.target.closest(HOVER_SEL)) {
      dot.classList.add("cur-hover");
      ring.classList.add("cur-hover");
    }
  });
  document.addEventListener("mouseout", function (e) {
    if (e.target.closest(HOVER_SEL)) {
      dot.classList.remove("cur-hover");
      ring.classList.remove("cur-hover");
    }
  });
  document.addEventListener("mousedown", function () {
    dot.classList.add("cur-click");
    ring.classList.add("cur-click");
  });
  document.addEventListener("mouseup", function () {
    dot.classList.remove("cur-click");
    ring.classList.remove("cur-click");
  });
  document.addEventListener("mouseleave", function () {
    dot.classList.remove("cur-visible");
    ring.classList.remove("cur-visible");
  });
  document.addEventListener("mouseenter", function () {
    if (hasMoved) {
      dot.classList.add("cur-visible");
      ring.classList.add("cur-visible");
    }
  });
})();
</script>
