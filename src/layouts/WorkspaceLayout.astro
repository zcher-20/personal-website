---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;

const APP_NAV = [
  { label: "Home",         icon: "mdi:home-outline",          href: "/" },
  { label: "About",        icon: "mdi:account-outline",       href: "/about" },
  { label: "Experience",   icon: "mdi:briefcase-outline",     href: "/about#experience" },
  { label: "Mind",         icon: "mdi:brain",                 href: "/mind" },
  { label: "Bookshelf",    icon: "mdi:book-open-outline",     href: "/books" },
  { label: "Photography",  icon: "mdi:camera-outline",        href: "/photography" },
];

const path = Astro.url.pathname;
---

<Layout seo={seo} canvasPage={true} noNav={true}>
  <slot name="head" slot="head" />
  <div class="ws-shell">

    <!-- Shared page header -->
    <div class="ws-page-header">
      <div class="ws-page-header-left">
        <span class="ws-page-name">Zayneb Cherif</span>
        <span class="ws-page-sub">Creative Technologist · AI & Design Engineer</span>
        <div class="ws-page-socials">
          <a href="https://www.linkedin.com/in/zayneb-cherif-830294251/" target="_blank" rel="noopener noreferrer" class="ws-page-social-link">LinkedIn ↗</a>
          <span class="ws-page-social-sep">·</span>
          <a href="https://github.com/zcher-20" target="_blank" rel="noopener noreferrer" class="ws-page-social-link">GitHub ↗</a>
          <span class="ws-page-social-sep">·</span>
          <a href="mailto:zaynebcheriff@gmail.com" class="ws-page-social-link">Gmail ↗</a>
        </div>
      </div>
      <nav class="site-nav">
        <a href="/" class={`site-nav-link ${path === "/" ? "active" : ""}`}>Home</a>
        <div class="site-nav-dropdown">
          <a href="/about" class={`site-nav-link ${path.startsWith("/about") ? "active" : ""}`}>About Me <span class="site-nav-caret">▾</span></a>
          <div class="site-nav-dropdown-menu">
            <a href="/about#experience" class="site-nav-dropdown-item">Experience</a>
            <a href="/about#about" class="site-nav-dropdown-item">Skills</a>
            <a href="/about#projects" class="site-nav-dropdown-item">Selected Work</a>
            <a href="/about#interests" class="site-nav-dropdown-item">Interests</a>
          </div>
        </div>
        <a href="/resume" class={`site-nav-link ${path === "/resume" ? "active" : ""}`}>Resume</a>
      </nav>

      <!-- Mobile hamburger -->
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu" onclick="(function(){var b=document.getElementById('mobile-menu-btn');var m=document.getElementById('mobile-menu');if(b&&m){b.classList.toggle('open');m.classList.toggle('open');}})()">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Page content -->
    <main class="ws-main">
      <slot />
      <footer class="ws-footer">
        <div class="wsf-identity">
          <span class="wsf-name">Zayneb Cherif</span>
          <img src="/favicon.png" alt="Z" class="wsf-logo" />
          <span class="wsf-copy">© 2026</span>
        </div>
        <div class="wsf-contact">
          <span class="wsf-tagline">Let's work together!</span>
          <a href="mailto:zaynebcheriff@gmail.com" class="wsf-email">zaynebcheriff@gmail.com</a>
          <div class="wsf-icons">
            <a href="https://www.linkedin.com/in/zayneb-cherif-830294251/" target="_blank" rel="noopener noreferrer" class="wsf-icon-link" aria-label="LinkedIn">
              <Icon name="mdi:linkedin" class="wsf-icon" />
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="wsf-icon-link" aria-label="Instagram">
              <Icon name="mdi:instagram" class="wsf-icon" />
            </a>
            <a href="/" class="wsf-icon-link" aria-label="Site">
              <Icon name="mdi:star-four-points" class="wsf-icon" />
            </a>
            <a href="https://github.com/zcher-20" target="_blank" rel="noopener noreferrer" class="wsf-icon-link" aria-label="GitHub">
              <Icon name="mdi:github" class="wsf-icon" />
            </a>
          </div>
        </div>
      </footer>
    </main>

  </div>

  <!-- Mobile nav menu (outside ws-shell to avoid overflow clipping) -->
  <div class="mobile-menu" id="mobile-menu">
    <a href="/about" class="mobile-menu-link">About Me</a>
    <a href="/about#experience" class="mobile-menu-sublink">Experience</a>
    <a href="/about#about" class="mobile-menu-sublink">Skills</a>
    <a href="/about#projects" class="mobile-menu-sublink">Selected Work</a>
    <a href="/about#interests" class="mobile-menu-sublink">Interests</a>
    <a href="/" class="mobile-menu-link">Projects</a>
    <a href="/resume" class="mobile-menu-link">Resume</a>
  </div>

</Layout>

<script is:inline>
  function closeMenu() {
    var btn = document.getElementById("mobile-menu-btn");
    var menu = document.getElementById("mobile-menu");
    if (btn) btn.classList.remove("open");
    if (menu) menu.classList.remove("open");
  }
  function initHamburger() {
    var btn = document.getElementById("mobile-menu-btn");
    var menu = document.getElementById("mobile-menu");
    if (!btn || !menu || btn._hamburgerInit) return;
    btn._hamburgerInit = true;
    btn.addEventListener("click", function() {
      btn.classList.toggle("open");
      menu.classList.toggle("open");
    });
    menu.querySelectorAll("a").forEach(function(a) {
      a.addEventListener("click", closeMenu);
    });
  }
  document.addEventListener("DOMContentLoaded", initHamburger);
  document.addEventListener("astro:page-load", initHamburger);
</script>

<script>
  import gsap from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";
  gsap.registerPlugin(TextPlugin);

  function initLayoutAnimations() {
    const isResume = window.location.pathname === "/resume";
    if (isResume) return;

    // ── 2. Name word reveal ──
    const nameEl = document.querySelector<HTMLElement>(".ws-page-name");
    if (nameEl && !nameEl.dataset.animated) {
      nameEl.dataset.animated = "1";
      const words = (nameEl.textContent ?? "").trim().split(" ");
      nameEl.innerHTML = words.map(w => `<span class="name-word" style="display:inline-block;overflow:hidden;vertical-align:bottom"><span style="display:inline-block">${w}</span></span>`).join(" ");
      gsap.from(".ws-page-name .name-word span", {
        y: 20, opacity: 0, duration: 0.5, stagger: 0.1, ease: "power2.out", delay: 0.1
      });
    }

    // ── 10. Subtitle typewriter ──
    const subEl = document.querySelector<HTMLElement>(".ws-page-sub");
    if (subEl && !subEl.dataset.typed) {
      subEl.dataset.typed = "1";
      const original = (subEl.textContent ?? "").trim();
      subEl.textContent = "";
      gsap.to(subEl, { duration: 0.8, text: original, ease: "none", delay: 0.1 });
    }

  }

  document.addEventListener("astro:page-load", initLayoutAnimations);

</script>

<script is:inline>
  (function () {
    // Fix scroll-reveal inside the ws-main scrollable container
    function initScrollReveal() {
      var container = document.querySelector(".ws-main");
      if (!container) return;
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      }, { root: container, threshold: 0.05 });
      document.querySelectorAll(".scroll-reveal").forEach(function(el) {
        observer.observe(el);
      });
    }
    document.addEventListener("astro:page-load", initScrollReveal);
    initScrollReveal();

    var sidebar    = document.getElementById("app-sidebar");
    var toggleBtn  = document.getElementById("sidebar-toggle-btn");
    var iconClose  = document.getElementById("toggle-icon-close");
    var iconOpen   = document.getElementById("toggle-icon-open");
    var flyout     = document.getElementById("sidebar-flyout");

    function collapse() {
      sidebar.classList.remove("open");
      sidebar.classList.add("collapsed");
      iconClose.classList.add("hidden");
      iconOpen.classList.remove("hidden");
    }
    function expand() {
      sidebar.classList.remove("collapsed");
      sidebar.classList.add("open");
      iconClose.classList.remove("hidden");
      iconOpen.classList.add("hidden");
      flyout.classList.add("hidden");
    }

    toggleBtn.addEventListener("click", function() {
      sidebar.classList.contains("open") ? collapse() : expand();
    });

    var t;
    sidebar.addEventListener("mouseenter", function () {
      if (!sidebar.classList.contains("collapsed")) return;
      clearTimeout(t); flyout.classList.remove("hidden");
    });
    sidebar.addEventListener("mouseleave", function () {
      if (!sidebar.classList.contains("collapsed")) return;
      t = setTimeout(function () { flyout.classList.add("hidden"); }, 150);
    });
    flyout.addEventListener("mouseenter", function () { clearTimeout(t); });
    flyout.addEventListener("mouseleave", function () {
      t = setTimeout(function () { flyout.classList.add("hidden"); }, 150);
    });
  })();
</script>

<style>
  /* ── Shared page header ── */
  .ws-page-header {
    flex-shrink: 0;
    display: flex; align-items: flex-end; justify-content: space-between;
    padding: 52px 40px 6px;
  }
  .ws-page-header-left { display: flex; flex-direction: column; gap: 8px; }
  .ws-page-name {
    font-size: 28px; font-weight: 600; letter-spacing: -0.02em;
    color: #1d1d1f; line-height: 1;
  }
  .ws-page-sub { font-size: 15px; color: #3d3d3d; line-height: 1; font-weight: 600; }
  .ws-page-socials { display: flex; align-items: center; gap: 6px; }
  .ws-page-social-link {
    font-size: 12px; color: #7a7a7a; font-weight: 600;
    text-decoration: none; transition: color 0.15s;
  }
  .ws-page-social-link:hover { color: #1d1d1f; }
  .ws-page-social-sep { font-size: 12px; color: #c0c0c0; }

  /* ── Shared site nav ── */
  .site-nav { display: flex; align-items: center; gap: 4px; padding-bottom: 4px; align-self: center; }
  .site-nav-link {
    font-size: 14px; color: #2a2a2a; font-weight: 600; text-decoration: none;
    padding: 5px 10px; border-radius: 6px;
    display: flex; align-items: center; gap: 3px;
    transition: background 0.15s, color 0.15s;
  }
  .site-nav-link:hover { background: rgba(0,0,0,0.04); color: #000; }
  .site-nav-link.active { color: #000; }
  .site-nav-caret { font-size: 9px; opacity: 0.5; }
  .site-nav-dropdown { position: relative; }
  .site-nav-dropdown-menu {
    display: flex; flex-direction: column;
    position: absolute; top: 100%; left: 10px;
    padding: 12px 0 0; min-width: 120px; z-index: 200;
    pointer-events: none;
  }
  .site-nav-dropdown:hover .site-nav-dropdown-menu { pointer-events: auto; }
  .site-nav-dropdown-item {
    font-size: 13px; color: #3a3a3a; text-decoration: none;
    padding: 3px 0;
    opacity: 0; transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.12s;
  }
  .site-nav-dropdown-item:nth-child(1) { transition-delay: 0.00s; }
  .site-nav-dropdown-item:nth-child(2) { transition-delay: 0.04s; }
  .site-nav-dropdown-item:nth-child(3) { transition-delay: 0.08s; }
  .site-nav-dropdown-item:nth-child(4) { transition-delay: 0.12s; }
  .site-nav-dropdown:hover .site-nav-dropdown-item {
    opacity: 1; transform: translateY(0);
  }
  .site-nav-dropdown-item:hover { color: #6b7fa3; font-weight: 600; }

  .ws-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background: linear-gradient(135deg, #f5e0e8 0%, #fff 40%, #fff 60%, #f5ede0 100%);
    font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    position: relative;
  }

  /* ── Sidebar ── */
  .app-sidebar {
    display: flex;
    flex-direction: column;
    background: #fff;
    overflow: hidden;
    transition: width 0.2s ease;
    flex-shrink: 0;
    padding-bottom: 24px;
  }
  .app-sidebar.open      { width: 220px; padding-top: 8px; align-items: stretch; }
  .app-sidebar.collapsed { width: 48px;  padding-top: 8px; align-items: center; }

  .app-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 16px 6px;
    flex-shrink: 0;
  }

  .sidebar-icon-btn {
    background: none; border: none; cursor: pointer;
    color: #c0c0c0; padding: 2px;
    display: flex; align-items: center;
    transition: color 0.15s;
  }
  .sidebar-icon-btn:hover { color: #5a5a5a; }

  /* Profile photo */
  .sidebar-photo-wrap {
    width: calc(100% - 48px);
    margin: 0 24px 20px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    flex-shrink: 0;
    background: #f5f5f7;
  }
  .sidebar-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .app-sidebar.collapsed .sidebar-photo-wrap { display: none; }

  .sidebar-divider {
    height: 1px; background: #f0f0f0;
    margin: 10px 16px 14px; flex-shrink: 0;
  }
  .app-sidebar.collapsed .sidebar-divider { display: none; }

  .nav-divider {
    height: 1px; background: #f0f0f0;
    margin: 6px 8px; flex-shrink: 0;
  }
  .app-sidebar.collapsed .nav-divider { margin: 6px 4px; }

  .app-nav {
    display: flex; flex-direction: column;
    gap: 2px; padding: 0 4px 0 12px; flex: 1;
  }
  .app-sidebar.collapsed .app-nav { padding: 0; align-items: center; gap: 4px; }

  .app-nav-btn {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 12px; border-radius: 8px;
    font-size: 13px; color: #7a7a7a;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap; width: 100%;
  }
  .app-nav-btn:hover  { background: rgba(0,0,0,0.04); color: var(--mauve); }
  .app-nav-btn.active { background: rgba(0,0,0,0.04); color: #2c4470; font-weight: 600; }
  .app-sidebar.collapsed .app-nav-btn { padding: 8px; width: auto; }

  .app-nav-icon  { width: 15px; height: 15px; flex-shrink: 0; }
  .app-nav-label { flex: 1; }
  .app-sidebar.collapsed .app-nav-label { display: none; }

  .sidebar-resume-wrap {
    margin-top: auto; padding: 0 4px 0 12px; flex-shrink: 0;
  }
  .app-sidebar.collapsed .sidebar-resume-wrap { padding: 0; display: flex; justify-content: center; }

  .sidebar-resume-btn {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 12px; border-radius: 8px;
    font-size: 13px; color: #7a7a7a;
    text-decoration: none; width: 100%;
    transition: background 0.15s, color 0.15s;
  }
  .sidebar-resume-btn:hover { background: rgba(0,0,0,0.04); color: var(--mauve); }
  .app-sidebar.collapsed .sidebar-resume-btn { padding: 8px; width: auto; }



  /* Flyout */
  .sidebar-flyout {
    position: absolute; left: 48px; top: 0; z-index: 50;
    background: #fff; border: 1px solid #f0f0f0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    border-radius: 10px; padding: 16px;
    display: flex; flex-direction: column; min-width: 160px;
  }
  .sidebar-flyout.hidden { display: none; }

  .flyout-item {
    display: flex; align-items: center; gap: 12px;
    padding: 6px 0; text-decoration: none;
  }
  .flyout-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #d0d0d0; flex-shrink: 0;
    transition: background 0.15s;
  }
  .flyout-item:hover .flyout-dot  { background: #1d1d1f; }
  .flyout-active .flyout-dot      { background: #2c4470; }
  .flyout-label {
    font-size: 12px; color: #7a7a7a;
    transition: color 0.15s;
  }
  .flyout-item:hover .flyout-label { color: var(--mauve); }
  .flyout-active .flyout-label     { color: #2c4470; font-weight: 500; }

  /* ── Main content ── */
  .ws-main {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    padding-top: 16px;
  }

  /* ── Footer ── */
  .ws-footer {
    display: flex; align-items: flex-start; justify-content: space-between;
    padding: 36px 32px 52px;
    gap: 24px;
  }
  .wsf-identity { display: flex; align-items: center; gap: 10px; }
  .wsf-name { font-size: 20px; font-weight: 300; letter-spacing: -0.02em; color: #1d1d1f; }
  .wsf-logo { width: 22px; height: 22px; object-fit: contain; opacity: 0.75; }
  .wsf-copy { font-size: 10.5px; color: #c0c0c0; text-transform: uppercase; letter-spacing: 0.07em; }
  .wsf-contact { display: flex; flex-direction: column; gap: 5px; align-items: flex-end; }
  .wsf-tagline { font-size: 12px; color: #7a7a7a; font-weight: 300; }
  .wsf-email { font-size: 14px; font-weight: 500; color: #1d1d1f; text-decoration: none; transition: color 0.15s; letter-spacing: -0.01em; }
  .wsf-email:hover { color: var(--mauve); }
  .wsf-icons { display: flex; align-items: center; gap: 16px; margin-top: 5px; }
  .wsf-icon-link { color: #9a9a9a; text-decoration: none; transition: color 0.15s; }
  .wsf-icon-link:hover { color: var(--mauve); }
  .wsf-icon { width: 18px; height: 18px; display: block; }

  /* ── Hamburger button (hidden on desktop) ── */
  .mobile-menu-btn {
    display: none;
    flex-direction: column; gap: 5px; justify-content: center;
    background: none; border: none; cursor: pointer; padding: 8px;
    position: fixed; top: 20px; right: 16px;
    z-index: 1001; pointer-events: auto;
  }
  .mobile-menu-btn span {
    display: block; width: 22px; height: 2px;
    background: #1d1d1f; border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .mobile-menu-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-menu-btn.open span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Mobile overrides ── */
  @media (max-width: 768px) {
    .app-sidebar    { display: none !important; }
    .sidebar-flyout { display: none !important; }
    .ws-main        { padding-bottom: 0; padding-top: 0; }

    /* Header: row with hamburger on the right */
    .ws-page-header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 40px 20px 10px;
    }
    .ws-page-name  { font-size: 20px; }
    .ws-page-sub   { font-size: 13px; }
    .ws-page-socials { gap: 4px; }
    .ws-page-social-link { font-size: 11px; }

    /* Hide desktop nav, show hamburger */
    .site-nav { display: none; }
    .mobile-menu-btn { display: flex; }

    /* Footer stacks on mobile */
    .ws-footer { flex-direction: row; gap: 16px; padding: 24px 16px 32px; align-items: flex-start; }
    .wsf-name { font-size: 16px; }
    .wsf-email { font-size: 12px; }
    .wsf-tagline { font-size: 11px; }
    .wsf-name { font-size: 16px; }
  }

  /* ── Mobile nav menu ── */
  .mobile-menu {
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: fixed;
    inset: 0;
    background: linear-gradient(135deg, #f5e0e8 0%, #fff 50%, #f5ede0 100%);
    padding: 60px 36px 40px;
    z-index: 999;
    pointer-events: none;
    clip-path: circle(0% at calc(100% - 44px) 44px);
    transition: clip-path 0.5s cubic-bezier(0.77, 0, 0.175, 1);
  }
  .mobile-menu.open {
    pointer-events: auto;
    clip-path: circle(150% at calc(100% - 44px) 44px);
  }
  .mobile-menu-link {
    font-size: 28px; font-weight: 600; color: #1d1d1f;
    text-decoration: none; padding: 10px 0;
    letter-spacing: -0.02em;
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.15s;
  }
  .mobile-menu.open .mobile-menu-link {
    opacity: 1; transform: translateY(0);
  }
  .mobile-menu.open .mobile-menu-link:nth-child(1) { transition-delay: 0.18s; }
  .mobile-menu.open .mobile-menu-link:nth-child(2) { transition-delay: 0.26s; }
  .mobile-menu.open .mobile-menu-link:nth-child(3) { transition-delay: 0.34s; }
  .mobile-menu-link:hover { color: #9a4a7a; }
  .mobile-menu-sublink {
    font-size: 15px; color: #7a7a7a;
    text-decoration: none; padding: 4px 0 4px 2px;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.15s;
  }
  .mobile-menu.open .mobile-menu-sublink { opacity: 1; transform: translateY(0); }
  .mobile-menu.open .mobile-menu-sublink:nth-child(2) { transition-delay: 0.22s; }
  .mobile-menu.open .mobile-menu-sublink:nth-child(3) { transition-delay: 0.26s; }
  .mobile-menu.open .mobile-menu-sublink:nth-child(4) { transition-delay: 0.30s; }
  .mobile-menu.open .mobile-menu-sublink:nth-child(5) { transition-delay: 0.34s; }
  .mobile-menu-sublink:hover { color: #3a3a3a; }
</style>
